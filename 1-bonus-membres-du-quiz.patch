+     *
+     * @return list<int>
+     */
+    private function quizMemberIds(Quiz $quiz): array
+    {
+        return $quiz->candidates()->pluck('user_id')
+            ->merge(QuizResult::where('quiz_id', $quiz->id)->whereNotNull('user_id')->pluck('user_id'))
+            ->unique()->map(fn ($id) => (int) $id)->values()->all();
+    }
