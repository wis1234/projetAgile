+}
+
+.native-mobile-app .mobile-app-shell p,
+.native-mobile-app .mobile-app-shell h1,
+.native-mobile-app .mobile-app-shell h2,
+.native-mobile-app .mobile-app-shell h3,
+.native-mobile-app .mobile-app-shell textarea,
+.native-mobile-app .mobile-app-shell input {
+  -webkit-touch-callout: default;
+}
+
+/* Retour tactile immédiat sur tout ce qui se touche dans les pages adaptées */
+.native-mobile-app .mobile-native-content button:not(:disabled),
+.native-mobile-app .mobile-native-content a[href] {
+  transition: transform 120ms ease, background-color 150ms ease, opacity 150ms ease;
+}
+.native-mobile-app .mobile-native-content button:not(:disabled):active,
+.native-mobile-app .mobile-native-content a[href]:active {
+  transform: scale(0.98);
+}
+
+/* Champs : 16 px minimum (évite le zoom automatique d'iOS) et coins arrondis cohérents */
