+                      <p className="text-[10px] font-bold uppercase tracking-widest text-indigo-200"><FaLayerGroup className="mr-1 inline" />Cumul</p>
+                      <h4 className="mt-0.5 text-base font-extrabold leading-tight line-clamp-2">{c.title}</h4>
