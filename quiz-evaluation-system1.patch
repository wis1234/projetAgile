+<style type="text/css">
+    @page { margin: 1.4cm 1.2cm 1.6cm 1.2cm; }
+    * { box-sizing: border-box; }
+    body { font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif; font-size: 9.5pt; color: #1f2937; margin: 0; }
+    .header { border-bottom: 3px solid #2563eb; padding-bottom: 8px; margin-bottom: 12px; }
+    .brand { font-size: 8pt; letter-spacing: 1.5px; color: #2563eb; font-weight: bold; text-transform: uppercase; }
+    h1 { font-size: 17pt; margin: 3px 0 2px 0; color: #111827; }
+    .sub { color: #6b7280; font-size: 9pt; }
+    .badge { display: inline-block; padding: 3px 9px; border-radius: 10px; font-size: 8pt; font-weight: bold; }
+    .badge-ok { background: #d1fae5; color: #065f46; }
+    .badge-warn { background: #fef3c7; color: #92400e; }
+    .stats { width: 100%; border-collapse: separate; border-spacing: 6px 0; margin: 10px -6px 12px -6px; }
+    .stats td { background: #f3f4f6; border-radius: 6px; padding: 7px 9px; text-align: center; }
+    .stats .v { font-size: 14pt; font-weight: bold; color: #111827; }
+    .stats .l { font-size: 7.5pt; color: #6b7280; text-transform: uppercase; }
+    table.grid { width: 100%; border-collapse: collapse; }
+    table.grid th { background: #2563eb; color: #fff; padding: 6px 5px; font-size: 8.5pt; text-align: center; border: 1px solid #1d4ed8; }
+    table.grid td { padding: 5px; border: 1px solid #e5e7eb; text-align: center; }
+    table.grid td.left, table.grid th.left { text-align: left; }
+    table.grid tr:nth-child(even) td { background: #f9fafb; }
+    .rank { font-weight: bold; }
+    .top1 td { background: #fef3c7 !important; }
+    .pass { color: #047857; font-weight: bold; }
+    .fail { color: #b91c1c; font-weight: bold; }
+    .pend { color: #b45309; font-weight: bold; }
+    .final { font-weight: bold; font-size: 10pt; }
+    .small { font-size: 8pt; color: #6b7280; }
+    .sign { width: 100%; margin-top: 22px; border-collapse: separate; border-spacing: 8px 0; }
+    .sign td { border: 1px solid #d1d5db; border-radius: 6px; padding: 8px; vertical-align: top; font-size: 8.5pt; }
+    .footer { position: fixed; bottom: -0.9cm; left: 0; right: 0; text-align: center; font-size: 7.5pt; color: #9ca3af; }
+    .watermark { color: #b45309; background: #fffbeb; border: 1px dashed #f59e0b; padding: 6px 10px; margin-bottom: 10px; font-size: 8.5pt; }
+</style>
