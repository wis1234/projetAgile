+                          <td key={q.id} className="px-3 py-3 text-center">
+                            {note !== undefined ? (
+                              <span className={`font-semibold ${note >= 50 ? 'text-gray-800 dark:text-gray-200' : 'text-red-600 dark:text-red-400'}`}>{fmtNumber(note)}</span>
