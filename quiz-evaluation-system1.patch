+          </div>
+        </div>
+
+        <p className="text-xs text-gray-500 dark:text-gray-400 px-1">
+          Moyenne = Σ (note × coefficient) ÷ Σ coefficients · quiz non passé : {method.missing_policy === 'ignore' ? 'ignoré' : 'compté pour 0'}
