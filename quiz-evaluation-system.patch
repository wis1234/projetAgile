@@ -0,0 +1,310 @@
+import React, { useEffect, useState } from 'react';
+import { Link } from '@inertiajs/react';
+import { FaArrowLeft, FaFileExcel, FaFilePdf, FaLock, FaTimes, FaHourglassHalf } from 'react-icons/fa';
+import { formatScore, initials, TONES } from '@/lib/quiz';
+
+/* ------------------------------------------------------------------ */
+/* Avatar                                                               */
+/* ------------------------------------------------------------------ */
+
+const AVATAR_SIZES = {
+  xs: 'w-6 h-6 text-[10px]',
+  sm: 'w-8 h-8 text-xs',
+  md: 'w-10 h-10 text-sm',
+  lg: 'w-12 h-12 text-base',
+  xl: 'w-16 h-16 text-lg',
+};
+
+export function Avatar({ name, src, size = 'md', className = '', ring = '' }) {
+  const [failed, setFailed] = useState(false);
+  const sizeClass = AVATAR_SIZES[size] || AVATAR_SIZES.md;
+
+  if (src && !failed) {
+    return (
+      <img
+        src={src}
+        alt={name || ''}
+        title={name}
+        loading="lazy"
+        onError={() => setFailed(true)}
+        className={`${sizeClass} rounded-full object-cover flex-shrink-0 ${ring} ${className}`}
+      />
+    );
+  }
+
+  return (
+    <span
+      title={name}
+      className={`${sizeClass} rounded-full flex-shrink-0 inline-flex items-center justify-center font-bold bg-gradient-to-br from-blue-500 to-indigo-600 text-white ${ring} ${className}`}
+    >
+      {initials(name)}
+    </span>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Score                                                                */
+/* ------------------------------------------------------------------ */
+
+/** Affiche « En attente » à la place d'un faux 0 % tant qu'une copie écrite n'est pas corrigée. */
+export function ScoreDisplay({ score, pending = false, suffix = '%', className = '' }) {
+  if (pending) {
+    return (
+      <span className={`inline-flex items-center gap-1.5 text-amber-600 dark:text-amber-400 font-bold ${className}`}>
+        <FaHourglassHalf className="text-[0.8em]" /> En attente
+      </span>
+    );
+  }
+  return (
+    <span className={className}>
+      {formatScore(score)}
+      {suffix}
+    </span>
+  );
+}
+
+export function Pill({ tone = 'gray', icon, children, className = '' }) {
+  return (
+    <span className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold ${TONES[tone].pill} ${className}`}>
+      {icon}
+      {children}
+    </span>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Cartes & mise en page                                                */
+/* ------------------------------------------------------------------ */
+
+export function Card({ children, className = '', padded = true }) {
+  return (
+    <div
+      className={`bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm ${
+        padded ? 'p-5 sm:p-6' : ''
+      } ${className}`}
+    >
+      {children}
+    </div>
+  );
+}
+
+export function StatCard({ icon, label, value, hint, tone = 'blue' }) {
+  return (
+    <div className="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm p-4 flex items-center gap-3">
+      <span className={`w-11 h-11 rounded-xl flex items-center justify-center text-lg flex-shrink-0 ${TONES[tone].soft}`}>{icon}</span>
+      <div className="min-w-0">
+        <div className="text-xl font-extrabold text-gray-900 dark:text-white leading-tight truncate">{value}</div>
+        <div className="text-xs text-gray-500 dark:text-gray-400 truncate">{label}</div>
+        {hint && <div className="text-[11px] text-gray-400 dark:text-gray-500 truncate">{hint}</div>}
+      </div>
+    </div>
+  );
+}
+
+export function PageShell({ children, max = 'max-w-6xl' }) {
+  return (
+    <div className="min-h-screen bg-gray-50 dark:bg-gray-950 py-6 sm:py-8">
+      <div className={`${max} mx-auto px-4 sm:px-6 lg:px-8 space-y-5 sm:space-y-6`}>{children}</div>
+    </div>
+  );
+}
+
+export function BackLink({ href, children }) {
+  return (
+    <Link
+      href={href}
+      className="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition"
+    >
+      <FaArrowLeft className="text-xs" /> {children}
+    </Link>
+  );
+}
+
+export function ProgressBar({ value, max = 100, tone = 'blue', className = '' }) {
+  const pct = max > 0 ? Math.max(0, Math.min(100, (value / max) * 100)) : 0;
+  return (
+    <div className={`h-2 rounded-full bg-gray-100 dark:bg-gray-700 overflow-hidden ${className}`}>
+      <div className={`h-full rounded-full transition-all duration-500 ${TONES[tone].bar}`} style={{ width: `${pct}%` }} />
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Exports                                                              */
+/* ------------------------------------------------------------------ */
+
+export function ExportButtons({ xlsxUrl, pdfUrl, compact = false }) {
+  const base =
+    'inline-flex items-center justify-center gap-2 rounded-xl font-semibold text-sm transition border shadow-sm ' +
+    (compact ? 'px-3 py-2' : 'px-4 py-2.5');
+  return (
+    <div className="flex flex-wrap items-center gap-2">
+      <a
+        href={xlsxUrl}
+        className={`${base} bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border-emerald-200 dark:bg-emerald-950/30 dark:hover:bg-emerald-900/40 dark:text-emerald-300 dark:border-emerald-800`}
+      >
+        <FaFileExcel /> Excel
+      </a>
+      <a
+        href={pdfUrl}
+        className={`${base} bg-rose-50 hover:bg-rose-100 text-rose-700 border-rose-200 dark:bg-rose-950/30 dark:hover:bg-rose-900/40 dark:text-rose-300 dark:border-rose-800`}
+      >
+        <FaFilePdf /> PDF
+      </a>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Modales                                                              */
+/* ------------------------------------------------------------------ */
+
+export function Dialog({ open, onClose, title, icon, children, footer, size = 'max-w-md', closable = true }) {
+  useEffect(() => {
+    if (!open) return undefined;
+    const onKey = (e) => {
+      if (e.key === 'Escape' && closable) onClose?.();
+    };
+    document.addEventListener('keydown', onKey);
+    const previous = document.body.style.overflow;
+    document.body.style.overflow = 'hidden';
+    return () => {
+      document.removeEventListener('keydown', onKey);
+      document.body.style.overflow = previous;
+    };
+  }, [open, closable, onClose]);
+
+  if (!open) return null;
+
+  return (
+    <div className="fixed inset-0 z-[70] flex items-end sm:items-center justify-center p-0 sm:p-4" role="dialog" aria-modal="true">
+      <div className="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" onClick={closable ? onClose : undefined} />
+      <div
+        className={`relative w-full ${size} bg-white dark:bg-gray-800 rounded-t-3xl sm:rounded-3xl shadow-2xl border border-gray-100 dark:border-gray-700 max-h-[92vh] overflow-y-auto`}
+      >
+        {(title || closable) && (
+          <div className="flex items-start justify-between gap-3 px-6 pt-6">
+            <div className="flex items-center gap-3">
+              {icon && (
+                <span className="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg flex-shrink-0">
+                  {icon}
+                </span>
+              )}
+              <h3 className="text-lg font-extrabold text-gray-900 dark:text-white">{title}</h3>
+            </div>
+            {closable && (
+              <button
+                type="button"
+                onClick={onClose}
+                aria-label="Fermer"
+                className="p-2 -mr-2 -mt-1 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition"
+              >
+                <FaTimes />
+              </button>
+            )}
+          </div>
+        )}
+        <div className="px-6 py-5">{children}</div>
+        {footer && <div className="px-6 pb-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-2">{footer}</div>}
+      </div>
+    </div>
+  );
+}
+
+export function Button({ variant = 'primary', className = '', children, ...props }) {
+  const variants = {
+    primary: 'bg-blue-600 hover:bg-blue-700 text-white shadow-sm',
+    success: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm',
+    danger: 'bg-red-600 hover:bg-red-700 text-white shadow-sm',
+    subtle: 'bg-gray-100 hover:bg-gray-200 text-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600 dark:text-gray-200',
+    outline:
+      'bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 dark:text-gray-200 dark:border-gray-600',
+  };
+  return (
+    <button
+      type="button"
+      {...props}
+      className={`inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed ${variants[variant]} ${className}`}
+    >
+      {children}
+    </button>
+  );
+}
+
+/** Confirmation par mot de passe ProJA (aval de délibération, réouverture…). */
+export function PasswordConfirmModal({
+  open,
+  onClose,
+  onConfirm,
+  title = 'Confirmez avec votre mot de passe',
+  description,
+  confirmLabel = 'Confirmer',
+  processing = false,
+  error,
+  variant = 'success',
+}) {
+  const [password, setPassword] = useState('');
+
+  useEffect(() => {
+    if (!open) setPassword('');
+  }, [open]);
+
+  const submit = (e) => {
+    e.preventDefault();
+    if (password) onConfirm(password);
+  };
+
+  return (
+    <Dialog
+      open={open}
+      onClose={processing ? undefined : onClose}
+      closable={!processing}
+      title={title}
+      icon={<FaLock />}
+      footer={
+        <>
+          <Button variant="subtle" onClick={onClose} disabled={processing}>
+            Annuler
+          </Button>
+          <Button variant={variant} onClick={submit} disabled={processing || !password}>
+            {processing ? 'Vérification…' : confirmLabel}
+          </Button>
+        </>
+      }
+    >
+      <form onSubmit={submit} className="space-y-3">
+        {description && <p className="text-sm text-gray-600 dark:text-gray-400">{description}</p>}
+        <div>
+          <label htmlFor="proja-password" className="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
+            Mot de passe ProJA
+          </label>
+          <input
+            id="proja-password"
+            type="password"
+            autoFocus
+            autoComplete="current-password"
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            className="w-full rounded-xl border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:text-white text-sm focus:border-blue-500 focus:ring-blue-500"
+            placeholder="••••••••"
+          />
+          {error && <p className="text-xs text-red-500 mt-1.5">{error}</p>}
+        </div>
+      </form>
+    </Dialog>
+  );
+}
+
+export function Field({ label, error, hint, children }) {
+  return (
+    <div>
+      {label && <label className="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">{label}</label>}
+      {children}
+      {hint && !error && <p className="text-[11px] text-gray-400 mt-1">{hint}</p>}
+      {error && <p className="text-xs text-red-500 mt-1">{error}</p>}
+    </div>
+  );
+}
+
+export const inputClass =
+  'w-full rounded-xl border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:text-white text-sm focus:border-blue-500 focus:ring-blue-500';
