@@ -0,0 +1,649 @@
+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import axios from 'axios';
+import { router } from '@inertiajs/react';
+import {
+  FaArrowDown,
+  FaArrowUp,
+  FaCheckCircle,
+  FaChevronDown,
+  FaChevronUp,
+  FaCompressAlt,
+  FaExpandAlt,
+  FaExclamationCircle,
+  FaLock,
+  FaPlus,
+  FaSave,
+  FaSpinner,
+  FaTrash,
+} from 'react-icons/fa';
+import { Button, Card, Field, Pill, inputClass } from '@/Components/Quiz/ui';
+import { apiError } from '@/lib/quiz';
+
+const OPTION_KEYS = ['a', 'b', 'c', 'd'];
+
+let keySeed = 0;
+const nextKey = () => `q-${Date.now().toString(36)}-${++keySeed}`;
+
+const blankQuestion = () => ({
+  key: nextKey(),
+  id: null,
+  question_text: '',
+  question_type: 'qcm',
+  option_a: '',
+  option_b: '',
+  option_c: '',
+  option_d: '',
+  correct_answer: 0,
+  _status: 'new', // new | dirty | saved | saving
+  _error: null,
+});
+
+const fromServer = (q) => ({
+  key: nextKey(),
+  id: q.id,
+  question_text: q.question_text || '',
+  question_type: q.question_type || 'qcm',
+  option_a: q.option_a || '',
+  option_b: q.option_b || '',
+  option_c: q.option_c || '',
+  option_d: q.option_d || '',
+  correct_answer: q.correct_answer ?? 0,
+  _status: 'saved',
+  _error: null,
+});
+
+const toPayload = (q, position) => ({
+  ...(q.id ? { id: q.id } : {}),
+  question_text: q.question_text,
+  question_type: q.question_type,
+  ...(q.question_type === 'qcm'
+    ? {
+        option_a: q.option_a,
+        option_b: q.option_b,
+        option_c: q.option_c,
+        option_d: q.option_d,
+        correct_answer: q.correct_answer,
+      }
+    : {}),
+  position,
+});
+
+/** Contrôle côté navigateur avant d'appeler le serveur. */
+function validateQuestion(q) {
+  if (!q.question_text.trim()) return "Renseignez l'intitulé de la question.";
+  if (q.question_type === 'qcm') {
+    if (!q.option_a.trim() || !q.option_b.trim()) return 'Les options A et B sont obligatoires.';
+    const chosen = q[`option_${OPTION_KEYS[q.correct_answer]}`];
+    if (!chosen || !chosen.trim()) return 'La bonne réponse doit correspondre à une option renseignée.';
+  }
+  return null;
+}
+
+const STATUS_PILL = {
+  new: { tone: 'amber', label: 'Non enregistrée' },
+  dirty: { tone: 'blue', label: 'Modifiée' },
+  saving: { tone: 'gray', label: 'Enregistrement…' },
+  saved: { tone: 'emerald', label: 'Enregistrée' },
+};
+
+export default function QuizEditor({ project, quiz = null, questionsLocked = false }) {
+  const isEdit = Boolean(quiz);
+
+  const [settings, setSettings] = useState({
+    title: quiz?.title || '',
+    description: quiz?.description || '',
+    duration_minutes: quiz?.duration_minutes || 15,
+    max_attempts: quiz?.max_attempts || 1,
+    is_active: quiz?.is_active ?? true,
+    show_results: quiz?.show_results ?? true,
+  });
+  const [quizId, setQuizId] = useState(quiz?.id || null);
+  const [questions, setQuestions] = useState(() =>
+    quiz?.questions?.length ? quiz.questions.map(fromServer) : [blankQuestion()]
+  );
+  const [errors, setErrors] = useState({});
+  const [processing, setProcessing] = useState(false);
+  const [newestFirst, setNewestFirst] = useState(true);
+  const [collapsed, setCollapsed] = useState(() => new Set());
+  const [focusKey, setFocusKey] = useState(null);
+  const leavingRef = useRef(false);
+
+  const base = `/projects/${project.id}/quizzes`;
+  const locked = questionsLocked;
+
+  const unsaved = useMemo(() => questions.filter((q) => q._status !== 'saved').length, [questions]);
+  const savedCount = questions.length - unsaved;
+
+  // Prévient avant de quitter la page avec des questions non enregistrées.
+  useEffect(() => {
+    const handler = (e) => {
+      if (leavingRef.current || unsaved === 0 || locked) return;
+      e.preventDefault();
+      e.returnValue = '';
+    };
+    window.addEventListener('beforeunload', handler);
+    return () => window.removeEventListener('beforeunload', handler);
+  }, [unsaved, locked]);
+
+  const patchQuestion = useCallback((key, patch) => {
+    setQuestions((list) => list.map((q) => (q.key === key ? { ...q, ...patch } : q)));
+  }, []);
+
+  const updateField = (key, field, value) => {
+    setQuestions((list) =>
+      list.map((q) =>
+        q.key === key
+          ? { ...q, [field]: value, _status: q._status === 'new' ? 'new' : 'dirty', _error: null }
+          : q
+      )
+    );
+  };
+
+  const updateSetting = (field, value) => {
+    setSettings((s) => ({ ...s, [field]: value }));
+    setErrors((e) => ({ ...e, [field]: undefined }));
+  };
+
+  // ------------------------------------------------------------------
+  // Actions sur la liste
+  // ------------------------------------------------------------------
+
+  const addQuestion = () => {
+    const q = blankQuestion();
+    setQuestions((list) => [...list, q]);
+    setFocusKey(q.key); // s'affiche en haut de la liste : aucun défilement nécessaire
+    if (!newestFirst) window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
+  };
+
+  const persistOrder = async (list) => {
+    if (!quizId || list.some((q) => !q.id)) return; // l'ordre final est de toute façon envoyé à « Enregistrer le quiz »
+    try {
+      await axios.put(`${base}/${quizId}/questions-order`, { ids: list.map((q) => q.id) });
+    } catch (e) {
+      /* silencieux : l'ordre sera resynchronisé à l'enregistrement du quiz */
+    }
+  };
+
+  // direction : -1 = monter dans la liste affichée, +1 = descendre
+  const moveVisual = (key, direction) => {
+    setQuestions((list) => {
+      const idx = list.findIndex((q) => q.key === key);
+      const step = newestFirst ? -direction : direction; // l'affichage « récentes d'abord » est inversé
+      const target = idx + step;
+      if (idx < 0 || target < 0 || target >= list.length) return list;
+      const copy = [...list];
+      [copy[idx], copy[target]] = [copy[target], copy[idx]];
+      persistOrder(copy);
+      return copy;
+    });
+  };
+
+  const removeQuestion = async (q) => {
+    if (questions.length === 1) {
+      alert('Un quiz doit contenir au moins une question.');
+      return;
+    }
+    if (q.question_text.trim() && !confirm('Supprimer cette question ?')) return;
+
+    if (q.id && quizId) {
+      try {
+        await axios.delete(`${base}/${quizId}/questions/${q.id}`);
+      } catch (e) {
+        patchQuestion(q.key, { _error: apiError(e, 'Suppression impossible.') });
+        return;
+      }
+    }
+    setQuestions((list) => list.filter((x) => x.key !== q.key));
+  };
+
+  const toggleCollapsed = (key) =>
+    setCollapsed((set) => {
+      const next = new Set(set);
+      next.has(key) ? next.delete(key) : next.add(key);
+      return next;
+    });
+
+  const setAllCollapsed = (value) => setCollapsed(value ? new Set(questions.map((q) => q.key)) : new Set());
+
+  // ------------------------------------------------------------------
+  // Enregistrement question par question
+  // ------------------------------------------------------------------
+
+  const saveQuestion = async (q) => {
+    const problem = validateQuestion(q);
+    if (problem) {
+      patchQuestion(q.key, { _error: problem });
+      return;
+    }
+
+    const position = questions.findIndex((x) => x.key === q.key) + 1;
+    patchQuestion(q.key, { _status: 'saving', _error: null });
+
+    try {
+      let saved;
+
+      if (!quizId) {
+        // Première question enregistrée : on crée le quiz en brouillon.
+        if (!settings.title.trim()) {
+          patchQuestion(q.key, { _status: q._status, _error: "Donnez d'abord un titre au quiz (paramètres généraux)." });
+          setErrors((e) => ({ ...e, title: 'Le titre est obligatoire.' }));
+          window.scrollTo({ top: 0, behavior: 'smooth' });
+          return;
+        }
+        const { data } = await axios.post(`${base}/draft`, { ...settings, question: toPayload(q, position) });
+        setQuizId(data.quiz.id);
+        saved = data.question;
+      } else if (q.id) {
+        const { data } = await axios.put(`${base}/${quizId}/questions/${q.id}`, toPayload(q, position));
+        saved = data.question;
+      } else {
+        const { data } = await axios.post(`${base}/${quizId}/questions`, toPayload(q, position));
+        saved = data.question;
+      }
+
+      patchQuestion(q.key, { id: saved.id, _status: 'saved', _error: null });
+      setCollapsed((set) => new Set(set).add(q.key)); // une question terminée se replie : la liste reste courte
+    } catch (e) {
+      patchQuestion(q.key, { _status: q.id ? 'dirty' : 'new', _error: apiError(e, "Impossible d'enregistrer la question.") });
+    }
+  };
+
+  // ------------------------------------------------------------------
+  // Enregistrement du quiz complet
+  // ------------------------------------------------------------------
+
+  const saveQuiz = () => {
+    const nextErrors = {};
+    if (!settings.title.trim()) nextErrors.title = 'Le titre est obligatoire.';
+    if (!locked) {
+      let firstInvalid = null;
+      questions.forEach((q) => {
+        const problem = validateQuestion(q);
+        if (problem) {
+          patchQuestion(q.key, { _error: problem });
+          firstInvalid ??= q.key;
+        }
+      });
+      if (firstInvalid) nextErrors.questions = 'Corrigez les questions signalées avant d\'enregistrer le quiz.';
+    }
+    setErrors(nextErrors);
+    if (Object.keys(nextErrors).length) {
+      window.scrollTo({ top: 0, behavior: 'smooth' });
+      return;
+    }
+
+    const data = {
+      ...settings,
+      ...(locked ? {} : { questions: questions.map((q, i) => toPayload(q, i + 1)) }),
+    };
+
+    const options = {
+      preserveScroll: true,
+      onStart: () => {
+        setProcessing(true);
+        leavingRef.current = true;
+      },
+      onError: (errs) => {
+        leavingRef.current = false;
+        setErrors(errs);
+        // Reporte les erreurs "questions.N.champ" sur la bonne carte.
+        Object.entries(errs).forEach(([field, message]) => {
+          const match = field.match(/^questions\.(\d+)\./);
+          if (match && questions[Number(match[1])]) {
+            patchQuestion(questions[Number(match[1])].key, { _error: message });
+          }
+        });
+      },
+      onFinish: () => setProcessing(false),
+    };
+
+    if (quizId) router.put(`${base}/${quizId}`, data, options);
+    else router.post(base, data, options);
+  };
+
+  // ------------------------------------------------------------------
+  // Rendu
+  // ------------------------------------------------------------------
+
+  const displayed = useMemo(() => {
+    const withNumber = questions.map((q, i) => ({ q, number: i + 1 }));
+    return newestFirst ? [...withNumber].reverse() : withNumber;
+  }, [questions, newestFirst]);
+
+  return (
+    <div className="space-y-5 sm:space-y-6">
+      {/* Paramètres généraux + bouton d'enregistrement en haut à droite */}
+      <Card>
+        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-5 border-b border-gray-100 dark:border-gray-700">
+          <div>
+            <h2 className="text-base font-bold text-gray-900 dark:text-white">Paramètres généraux</h2>
+            <p className="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
+              {quizId ? (
+                <>
+                  <FaCheckCircle className="inline text-emerald-500 mr-1" />
+                  {savedCount} question(s) enregistrée(s){unsaved > 0 && ` · ${unsaved} non enregistrée(s)`}
+                </>
+              ) : (
+                'Enregistrez chaque question au fur et à mesure, puis publiez le quiz.'
+              )}
+            </p>
+          </div>
+          <Button variant="primary" onClick={saveQuiz} disabled={processing} className="w-full sm:w-auto">
+            {processing ? <FaSpinner className="animate-spin" /> : <FaSave />}
+            {isEdit && !quiz?.is_draft ? 'Mettre à jour le Quiz' : 'Enregistrer le Quiz'}
+          </Button>
+        </div>
+
+        {errors.questions && (
+          <div className="mb-4 px-4 py-2.5 rounded-xl bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 text-sm flex items-center gap-2">
+            <FaExclamationCircle /> {errors.questions}
+          </div>
+        )}
+
+        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
+          <div className="md:col-span-3">
+            <Field label="Titre du quiz *" error={errors.title}>
+              <input
+                type="text"
+                value={settings.title}
+                onChange={(e) => updateSetting('title', e.target.value)}
+                placeholder="Ex : Évaluation de fin de sprint 1"
+                className={inputClass}
+              />
+            </Field>
+          </div>
+
+          <div className="md:col-span-3">
+            <Field label="Description" error={errors.description}>
+              <textarea
+                value={settings.description}
+                onChange={(e) => updateSetting('description', e.target.value)}
+                rows={2}
+                placeholder="Objectif, thèmes abordés…"
+                className={inputClass}
+              />
+            </Field>
+          </div>
+
+          <Field label="Durée (minutes) *" error={errors.duration_minutes}>
+            <input
+              type="number"
+              min="1"
+              max="360"
+              value={settings.duration_minutes}
+              onChange={(e) => updateSetting('duration_minutes', parseInt(e.target.value, 10) || 1)}
+              className={inputClass}
+            />
+          </Field>
+
+          <Field label="Essais maximum *" error={errors.max_attempts}>
+            <input
+              type="number"
+              min="1"
+              max="100"
+              value={settings.max_attempts}
+              onChange={(e) => updateSetting('max_attempts', parseInt(e.target.value, 10) || 1)}
+              className={inputClass}
+            />
+          </Field>
+
+          <div className="flex flex-col justify-end gap-2.5 pb-1">
+            <label className="flex items-center gap-2 cursor-pointer text-sm font-medium text-gray-700 dark:text-gray-300">
+              <input
+                type="checkbox"
+                checked={settings.is_active}
+                onChange={(e) => updateSetting('is_active', e.target.checked)}
+                className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
+              />
+              Quiz actif
+            </label>
+            <label className="flex items-center gap-2 cursor-pointer text-sm font-medium text-gray-700 dark:text-gray-300">
+              <input
+                type="checkbox"
+                checked={settings.show_results}
+                onChange={(e) => updateSetting('show_results', e.target.checked)}
+                className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
+              />
+              Afficher les résultats aux membres
+            </label>
+          </div>
+        </div>
+      </Card>
+
+      {locked && (
+        <div className="px-4 py-3 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-200 text-sm flex items-start gap-2.5">
+          <FaLock className="mt-0.5 flex-shrink-0" />
+          <span>
+            Des candidats ont déjà commencé ce quiz : les questions sont verrouillées pour ne pas fausser les notes. Vous
+            pouvez toujours modifier les paramètres généraux.
+          </span>
+        </div>
+      )}
+
+      {/* Questions */}
+      <Card>
+        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-5">
+          <div>
+            <h3 className="text-lg font-bold text-gray-900 dark:text-white">Questions ({questions.length})</h3>
+            <p className="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
+              {newestFirst
+                ? 'Les nouvelles questions apparaissent en haut de la liste.'
+                : "Affichage dans l'ordre du quiz."}
+            </p>
+          </div>
+          <div className="flex flex-wrap items-center gap-2">
+            <Button variant="outline" className="!px-3 !py-2 text-xs" onClick={() => setNewestFirst((v) => !v)}>
+              {newestFirst ? <FaArrowUp /> : <FaArrowDown />} {newestFirst ? 'Récentes en haut' : "Ordre du quiz"}
+            </Button>
+            <Button variant="outline" className="!px-3 !py-2 text-xs" onClick={() => setAllCollapsed(true)}>
+              <FaCompressAlt /> Tout réduire
+            </Button>
+            <Button variant="outline" className="!px-3 !py-2 text-xs" onClick={() => setAllCollapsed(false)}>
+              <FaExpandAlt /> Tout développer
+            </Button>
+            {!locked && (
+              <Button variant="primary" onClick={addQuestion}>
+                <FaPlus /> Ajouter une question
+              </Button>
+            )}
+          </div>
+        </div>
+
+        <div className="space-y-4">
+          {displayed.map(({ q, number }, position) => (
+            <QuestionCard
+              key={q.key}
+              q={q}
+              number={number}
+              locked={locked}
+              isCollapsed={collapsed.has(q.key)}
+              autoFocus={focusKey === q.key}
+              canMoveUp={position > 0}
+              canMoveDown={position < displayed.length - 1}
+              onToggle={() => toggleCollapsed(q.key)}
+              onChange={(field, value) => updateField(q.key, field, value)}
+              onMove={(dir) => moveVisual(q.key, dir)}
+              onRemove={() => removeQuestion(q)}
+              onSave={() => saveQuestion(q)}
+            />
+          ))}
+        </div>
+      </Card>
+    </div>
+  );
+}
+
+function QuestionCard({ q, number, locked, isCollapsed, autoFocus, canMoveUp, canMoveDown, onToggle, onChange, onMove, onRemove, onSave }) {
+  const textRef = useRef(null);
+  const status = STATUS_PILL[q._status];
+  const saving = q._status === 'saving';
+
+  useEffect(() => {
+    if (autoFocus) textRef.current?.focus();
+  }, [autoFocus]);
+
+  const summary = q.question_text.trim() || 'Question sans intitulé';
+
+  return (
+    <div
+      className={`rounded-2xl border transition ${
+        q._error
+          ? 'border-red-300 dark:border-red-800'
+          : q._status === 'saved'
+          ? 'border-gray-200 dark:border-gray-700'
+          : 'border-blue-200 dark:border-blue-900/60'
+      } bg-gray-50/70 dark:bg-gray-800/60`}
+    >
+      {/* En-tête */}
+      <div className="flex items-center justify-between gap-2 px-4 sm:px-5 py-3">
+        <button type="button" onClick={onToggle} className="flex items-center gap-2.5 min-w-0 flex-1 text-left">
+          <span className="w-8 h-8 rounded-lg bg-blue-600 text-white text-sm font-bold flex items-center justify-center flex-shrink-0">
+            {number}
+          </span>
+          <span className="min-w-0">
+            <span className="block text-sm font-semibold text-gray-800 dark:text-gray-100 truncate">{summary}</span>
+            <span className="flex items-center gap-1.5 mt-0.5">
+              <Pill tone={q.question_type === 'qcm' ? 'blue' : 'purple'}>{q.question_type === 'qcm' ? 'QCM' : 'Écrite'}</Pill>
+              <Pill tone={status.tone}>{status.label}</Pill>
+            </span>
+          </span>
+        </button>
+
+        <div className="flex items-center gap-0.5 flex-shrink-0">
+          {!locked && (
+            <>
+              <IconButton title="Monter" disabled={!canMoveUp} onClick={() => onMove(-1)}>
+                <FaArrowUp />
+              </IconButton>
+              <IconButton title="Descendre" disabled={!canMoveDown} onClick={() => onMove(1)}>
+                <FaArrowDown />
+              </IconButton>
+              <IconButton title="Supprimer la question" danger onClick={onRemove}>
+                <FaTrash />
+              </IconButton>
+            </>
+          )}
+          <IconButton title={isCollapsed ? 'Développer' : 'Réduire'} onClick={onToggle}>
+            {isCollapsed ? <FaChevronDown /> : <FaChevronUp />}
+          </IconButton>
+        </div>
+      </div>
+
+      {!isCollapsed && (
+        <div className="px-4 sm:px-5 pb-4 sm:pb-5 space-y-4 border-t border-gray-200/70 dark:border-gray-700 pt-4">
+          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+            <div className="md:col-span-2">
+              <Field label="Intitulé de la question *">
+                <textarea
+                  ref={textRef}
+                  value={q.question_text}
+                  onChange={(e) => onChange('question_text', e.target.value)}
+                  rows={2}
+                  disabled={locked}
+                  placeholder="Entrez le texte de la question…"
+                  className={inputClass}
+                />
+              </Field>
+            </div>
+            <Field label="Type de question">
+              <select
+                value={q.question_type}
+                onChange={(e) => onChange('question_type', e.target.value)}
+                disabled={locked}
+                className={inputClass}
+              >
+                <option value="qcm">Choix multiple (QCM)</option>
+                <option value="written">Réponse écrite</option>
+              </select>
+            </Field>
+          </div>
+
+          {q.question_type === 'qcm' ? (
+            <div className="space-y-2">
+              <label className="block text-xs font-semibold text-gray-700 dark:text-gray-300">
+                Options de réponse — cochez la bonne réponse *
+              </label>
+              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
+                {OPTION_KEYS.map((key, idx) => (
+                  <div
+                    key={key}
+                    className={`flex items-center gap-2 p-2 rounded-xl border transition ${
+                      q.correct_answer === idx
+                        ? 'border-emerald-500 bg-emerald-50/60 dark:bg-emerald-950/20'
+                        : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900'
+                    }`}
+                  >
+                    <input
+                      type="radio"
+                      name={`correct_${q.key}`}
+                      checked={q.correct_answer === idx}
+                      disabled={locked}
+                      onChange={() => onChange('correct_answer', idx)}
+                      className="text-emerald-600 focus:ring-emerald-500"
+                      aria-label={`Bonne réponse : option ${key.toUpperCase()}`}
+                    />
+                    <span className="font-bold text-xs uppercase text-gray-500 w-4">{key}</span>
+                    <input
+                      type="text"
+                      value={q[`option_${key}`]}
+                      disabled={locked}
+                      onChange={(e) => onChange(`option_${key}`, e.target.value)}
+                      placeholder={`Option ${key.toUpperCase()}${idx < 2 ? ' *' : ''}`}
+                      className="flex-1 min-w-0 bg-transparent border-0 text-sm focus:ring-0 dark:text-white p-0"
+                    />
+                  </div>
+                ))}
+              </div>
+            </div>
+          ) : (
+            <div className="p-3 bg-purple-50 dark:bg-purple-950/20 border border-purple-100 dark:border-purple-800/30 rounded-xl text-xs text-purple-700 dark:text-purple-300">
+              Les questions écrites sont corrigées manuellement (note sur 10, demi-points possibles) dans l'espace de
+              correction, après la soumission.
+            </div>
+          )}
+
+          {q._error && (
+            <div className="flex items-start gap-2 text-sm text-red-600 dark:text-red-400">
+              <FaExclamationCircle className="mt-0.5 flex-shrink-0" /> <span>{q._error}</span>
+            </div>
+          )}
+
+          {/* Enregistrement de cette question */}
+          {!locked && (
+            <div className="flex items-center justify-between gap-3 pt-3 border-t border-gray-200/70 dark:border-gray-700">
+              <span className="text-xs text-gray-500 dark:text-gray-400">
+                {q._status === 'saved'
+                  ? 'Cette question est enregistrée.'
+                  : 'Enregistrez cette question pour ne pas la perdre.'}
+              </span>
+              <Button
+                variant={q._status === 'saved' ? 'outline' : 'success'}
+                onClick={onSave}
+                disabled={saving || q._status === 'saved'}
+              >
+                {saving ? <FaSpinner className="animate-spin" /> : q._status === 'saved' ? <FaCheckCircle /> : <FaSave />}
+                {saving ? 'Enregistrement…' : q._status === 'saved' ? 'Enregistrée' : 'Enregistrer la question'}
+              </Button>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function IconButton({ children, danger = false, ...props }) {
+  return (
+    <button
+      type="button"
+      {...props}
+      className={`p-2 rounded-lg text-sm transition disabled:opacity-30 disabled:cursor-not-allowed ${
+        danger
+          ? 'text-red-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30'
+          : 'text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:hover:text-gray-200 dark:hover:bg-gray-700'
+      }`}
+    >
+      {children}
+    </button>
+  );
+}
