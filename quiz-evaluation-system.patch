+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizParticipationPoint;
+use App\Models\User;
+use App\Services\Quiz\DeliberationService;
+use App\Services\Quiz\QuizScoring;
+use App\Services\Quiz\ResultsService;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Validation\ValidationException;
+use Inertia\Inertia;
+
+/**
+ * Points de participation : récompenser l'implication pendant les formations.
+ * Ils pèsent dans la note finale selon le poids choisi (0 % = simple information).
+ */
+class QuizParticipationController extends Controller
+{
+    public function __construct(
+        private ResultsService $results,
+        private DeliberationService $deliberation,
+    ) {
+    }
+
+    public function show(Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $rows = $this->results->candidateRows($quiz)->keyBy('key');
+        $entries = $quiz->participations()->with('awarder:id,name')->latest()->get()->groupBy(fn ($p) => $p->candidateKey());
+
+        $candidates = collect();
+
+        // 1) Candidats ayant passé le quiz
+        foreach ($rows as $key => $row) {
+            $candidates[$key] = $this->candidate($key, $row['user_id'], $row['name'], $row['email'], $row['photo'], $row);
+        }
+
+        // 2) Membres du projet (hors responsables) qui n'ont pas encore passé le quiz
+        $project->users()->wherePivot('role', '!=', 'manager')
+            ->get(['users.id', 'users.name', 'users.email', 'users.profile_photo_path'])
+            ->each(function (User $u) use ($candidates, &$rows) {
+                $key = 'u:' . $u->id;
+                if (! $candidates->has($key)) {
+                    $candidates[$key] = $this->candidate($key, $u->id, $u->name, $u->email, $u->profile_photo_url, null);
+                }
+            });
+
+        // 3) Externes qui ont des points mais pas de résultat
+        foreach ($entries as $key => $list) {
+            if (! $candidates->has($key)) {
+                $first = $list->first();
+                $candidates[$key] = $this->candidate($key, $first->user_id, $first->guest_name ?? $first->guest_email, $first->guest_email, null, null);
+            }
+        }
+
+        $max = (float) $quiz->participation_max;
+        $payload = $candidates->map(function (array $c) use ($entries, $max) {
+            $list = $entries->get($c['key'], collect());
+            $total = round((float) $list->sum('points'), 2);
+            $c['total_points'] = max(0, $total);
+            $c['percent'] = QuizScoring::participationPercent($total, $max);
+            $c['entries'] = $list->map(fn (QuizParticipationPoint $p) => [
+                'id' => $p->id,
+                'points' => $p->points,
+                'reason' => $p->reason,
+                'session_label' => $p->session_label,
+                'awarded_by' => $p->awarder?->name,
+                'created_at' => $p->created_at?->toIso8601String(),
+            ])->values();
+
+            return $c;
+        })->sortByDesc('total_points')->values();
+
+        return Inertia::render('Quizzes/Participation', [
+            'project' => ['id' => $project->id, 'name' => $project->name],
+            'quiz' => $quiz->only(['id', 'title', 'participation_max', 'participation_weight', 'deliberation_status']),
+            'candidates' => $payload,
+            'isValidated' => $quiz->isValidated(),
+            'sessions' => $quiz->participations()->whereNotNull('session_label')->distinct()->pluck('session_label')->values(),
+        ]);
+    }
+
+    public function store(Request $request, Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+        if ($locked = $this->lockedRedirect($quiz)) {
+            return $locked;
+        }
+
+        $max = (float) $quiz->participation_max;
+
+        $data = $request->validate([
+            'candidate_key' => ['required', 'string', 'max:300'],
+            'points' => ['required', 'numeric', 'not_in:0', 'between:' . -$max . ',' . $max],
+            'reason' => ['nullable', 'string', 'max:255'],
+            'session_label' => ['nullable', 'string', 'max:120'],
+        ]);
+
+        [$type, $id] = array_pad(explode(':', $data['candidate_key'], 2), 2, null);
+        $attributes = ['quiz_id' => $quiz->id, 'user_id' => null, 'guest_email' => null, 'guest_name' => null];
+
+        if ($type === 'u' && ctype_digit((string) $id)) {
+            $user = User::find((int) $id);
+            $isCandidate = $user && (
+                $project->users()->where('users.id', $user->id)->exists()
+                || $quiz->results()->where('user_id', $user->id)->exists()
+            );
+            if (! $isCandidate) {
+                throw ValidationException::withMessages(['candidate_key' => 'Ce candidat ne fait pas partie du projet.']);
+            }
+            $attributes['user_id'] = $user->id;
+        } elseif ($type === 'g' && filter_var($id, FILTER_VALIDATE_EMAIL)) {
+            $result = $quiz->results()->whereNull('user_id')->where('guest_email', $id)->first();
+            $known = $result || $quiz->participations()->where('guest_email', $id)->exists();
+            if (! $known) {
+                throw ValidationException::withMessages(['candidate_key' => 'Candidat externe inconnu pour ce quiz.']);
+            }
+            $attributes['guest_email'] = mb_strtolower($id);
+            $attributes['guest_name'] = $result?->guest_name;
+        } else {
+            throw ValidationException::withMessages(['candidate_key' => 'Candidat invalide.']);
+        }
+
+        QuizParticipationPoint::create($attributes + [
+            'points' => $data['points'],
+            'reason' => $data['reason'] ?? null,
+            'session_label' => $data['session_label'] ?? null,
+            'awarded_by' => Auth::id(),
+        ]);
+
+        // La note finale change : les avals déjà donnés ne sont plus valables.
+        $this->deliberation->invalidate($quiz);
+
+        return back()->with('success', 'Points de participation enregistrés.');
+    }
+
+    public function destroy(Project $project, Quiz $quiz, QuizParticipationPoint $participation)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+        if ($locked = $this->lockedRedirect($quiz)) {
+            return $locked;
+        }
+
+        $participation->delete();
+        $this->deliberation->invalidate($quiz);
+
+        return back()->with('success', 'Attribution supprimée.');
+    }
+
+    public function settings(Request $request, Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+        if ($locked = $this->lockedRedirect($quiz)) {
+            return $locked;
+        }
+
+        $data = $request->validate([
+            'participation_max' => ['required', 'numeric', 'min:1', 'max:1000'],
+            'participation_weight' => ['required', 'integer', 'min:0', 'max:50'],
+        ]);
+
+        $quiz->update($data);
+        $this->deliberation->invalidate($quiz);
+
+        return back()->with('success', 'Paramètres de participation mis à jour.');
+    }
+
+    /** Résultats validés : on répond par un message sur la page (une erreur HTTP renverrait ailleurs). */
+    private function lockedRedirect(Quiz $quiz)
+    {
+        if (! $quiz->isValidated()) {
+            return null;
+        }
+
+        return back()->with('error', 'Les résultats sont validés : rouvrez la délibération pour modifier la participation.');
+    }
+
+    /** @param array<string, mixed>|null $row */
+    private function candidate(string $key, ?int $userId, ?string $name, ?string $email, ?string $photo, ?array $row): array
+    {
+        return [
+            'key' => $key,
+            'user_id' => $userId,
+            'name' => $name ?? 'Candidat',
+            'email' => $email,
+            'photo' => $photo,
+            'is_guest' => $userId === null,
+            'has_result' => $row !== null,
+            'quiz_score' => $row['quiz_score'] ?? null,
+            'final_score' => $row['final_score'] ?? null,
+            'pending' => $row['pending'] ?? false,
+        ];
+    }
+}
diff --git a/app/Http/Controllers/QuizQuestionController.php b/app/Http/Controllers/QuizQuestionController.php
new file mode 100644
index 0000000..2411dbb
--- /dev/null
+++ b/app/Http/Controllers/QuizQuestionController.php
@@ -0,0 +1,154 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Http\Requests\SaveQuestionRequest;
+use App\Http\Requests\SaveQuizDraftRequest;
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizQuestion;
+use App\Services\Quiz\QuizBuilder;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Enregistrement d'un quiz question par question (réponses JSON).
+ *
+ * La première question enregistrée crée un brouillon ; « Enregistrer le quiz » le publie.
+ */
+class QuizQuestionController extends Controller
+{
+    public function __construct(private QuizBuilder $builder)
+    {
+    }
+
+    public function draft(SaveQuizDraftRequest $request, Project $project): JsonResponse
+    {
+        $this->authorize('create', [Quiz::class, $project]);
+
+        $v = $request->validated();
+
+        [$quiz, $question] = DB::transaction(function () use ($v, $project) {
+            $quiz = Quiz::create([
+                'project_id' => $project->id,
+                'created_by' => Auth::id(),
+                'title' => $v['title'],
+                'description' => $v['description'] ?? null,
+                'quiz_type' => Quiz::deriveType([$v['question']['question_type']]),
+                'duration_minutes' => $v['duration_minutes'],
+                'max_attempts' => $v['max_attempts'],
+                'is_active' => $v['is_active'] ?? true,
+                'show_results' => $v['show_results'] ?? true,
+                'is_draft' => true,
+            ]);
+
+            $question = QuizQuestion::create(
+                $this->builder->normalize($v['question'], (int) ($v['question']['position'] ?? 1)) + ['quiz_id' => $quiz->id]
+            );
+
+            return [$quiz, $question];
+        });
+
+        return response()->json([
+            'quiz' => ['id' => $quiz->id, 'is_draft' => true],
+            'question' => $this->present($question),
+        ], 201);
+    }
+
+    public function store(SaveQuestionRequest $request, Project $project, Quiz $quiz): JsonResponse
+    {
+        $this->authorize('update', [$quiz, $project]);
+
+        if ($locked = $this->lockedResponse($quiz)) {
+            return $locked;
+        }
+
+        $v = $request->validated();
+        $order = (int) ($v['position'] ?? ($quiz->questions()->max('order') + 1));
+
+        $question = QuizQuestion::create($this->builder->normalize($v, $order) + ['quiz_id' => $quiz->id]);
+        $this->builder->refreshType($quiz);
+
+        return response()->json(['question' => $this->present($question)], 201);
+    }
+
+    public function update(SaveQuestionRequest $request, Project $project, Quiz $quiz, QuizQuestion $question): JsonResponse
+    {
+        $this->authorize('update', [$quiz, $project]);
+
+        if ($locked = $this->lockedResponse($quiz)) {
+            return $locked;
+        }
+
+        $v = $request->validated();
+        $question->update($this->builder->normalize($v, (int) ($v['position'] ?? $question->order)));
+        $this->builder->refreshType($quiz);
+
+        return response()->json(['question' => $this->present($question->refresh())]);
+    }
+
+    public function destroy(Project $project, Quiz $quiz, QuizQuestion $question): JsonResponse
+    {
+        $this->authorize('update', [$quiz, $project]);
+
+        if ($locked = $this->lockedResponse($quiz)) {
+            return $locked;
+        }
+
+        $question->delete();
+        $this->builder->refreshType($quiz);
+
+        return response()->json(['deleted' => true]);
+    }
+
+    /** Applique l'ordre choisi (liste d'identifiants de questions enregistrées). */
+    public function reorder(Request $request, Project $project, Quiz $quiz): JsonResponse
+    {
+        $this->authorize('update', [$quiz, $project]);
+
+        if ($locked = $this->lockedResponse($quiz)) {
+            return $locked;
+        }
+
+        $data = $request->validate([
+            'ids' => ['required', 'array', 'max:200'],
+            'ids.*' => ['integer'],
+        ]);
+
+        DB::transaction(function () use ($quiz, $data) {
+            foreach (array_values($data['ids']) as $index => $id) {
+                $quiz->questions()->where('id', $id)->update(['order' => $index + 1]);
+            }
+        });
+
+        return response()->json(['reordered' => true]);
+    }
+
+    private function lockedResponse(Quiz $quiz): ?JsonResponse
+    {
+        if ($quiz->questionsLocked()) {
+            return response()->json([
+                'message' => 'Des candidats ont déjà commencé ce quiz : ses questions ne peuvent plus être modifiées.',
+            ], 423);
+        }
+
+        return null;
+    }
+
+    private function present(QuizQuestion $q): array
+    {
+        return [
+            'id' => $q->id,
+            'order' => $q->order,
+            'question_text' => $q->question_text,
+            'question_type' => $q->question_type,
+            'option_a' => $q->option_a,
+            'option_b' => $q->option_b,
+            'option_c' => $q->option_c,
+            'option_d' => $q->option_d,
+            'correct_answer' => $q->correct_answer,
+        ];
+    }
+}
