+<?php
+
+namespace App\Http\Requests;
+
+use App\Http\Requests\Concerns\QuizRules;
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Validation\Validator;
+
+/** Création du brouillon lors de l'enregistrement de la toute première question. */
+class SaveQuizDraftRequest extends FormRequest
+{
+    use QuizRules;
+
+    public function rules(): array
+    {
+        return array_merge($this->settingsRules(), [
+            'question' => ['required', 'array'],
+        ], $this->questionRules('question.'));
+    }
+
+    public function withValidator(Validator $validator): void
+    {
+        $validator->after(fn ($v) => $this->assertCorrectOptionsFilled($v, [$this->input('question', [])], 'question.'));
+    }
+}
