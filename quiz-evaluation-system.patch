+import React from 'react';
+import { Link, router } from '@inertiajs/react';
+import { FaEye, FaLayerGroup, FaTrash } from 'react-icons/fa';
+import { ExportButtons } from '@/Components/Quiz/ui';
+import { formatDate, formatScore } from '@/lib/quiz';
+
+/** Carte d'un cumul : aperçu visuel (grille) des quiz mis ensemble + accès aux résultats et exports. */
+export default function CumulCard({ cumul, project }) {
+  const remove = () => {
+    if (confirm(`Supprimer le cumul « ${cumul.title} » ? Les quiz et leurs résultats ne sont pas touchés.`)) {
+      router.delete(route('projects.quiz-cumuls.destroy', [project.id, cumul.id]));
+    }
+  };
+
+  const exportUrl = (format) => route('projects.quiz-cumuls.export', [project.id, cumul.id, format]);
+
+  return (
+    <div className="bg-gradient-to-br from-indigo-50 to-white dark:from-indigo-950/30 dark:to-gray-800 rounded-2xl border border-indigo-100 dark:border-indigo-900/50 p-5 shadow-sm flex flex-col justify-between gap-4 hover:shadow-md transition">
+      <div className="space-y-3">
+        <div className="flex items-start justify-between gap-2">
+          <div className="min-w-0">
+            <span className="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-300">
+              <FaLayerGroup /> Cumul de {cumul.quizzes.length} quiz
+            </span>
+            <h3 className="text-lg font-bold text-gray-900 dark:text-white line-clamp-1 mt-0.5">{cumul.title}</h3>
+          </div>
+          <button
+            type="button"
+            onClick={remove}
+            className="p-2 text-gray-400 hover:text-red-600 rounded-lg transition flex-shrink-0"
+            title="Supprimer le cumul"
+          >
+            <FaTrash />
+          </button>
+        </div>
+
+        {cumul.description && <p className="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{cumul.description}</p>}
+
+        {/* Aperçu : les quiz mis ensemble */}
+        <div className="grid grid-cols-2 gap-2">
+          {cumul.quizzes.slice(0, 4).map((q, i) => (
+            <div
+              key={q.id}
+              className="rounded-xl bg-white dark:bg-gray-900 border border-indigo-100 dark:border-indigo-900/40 px-3 py-2 flex items-center gap-2 min-w-0"
+            >
+              <span className="w-6 h-6 rounded-md bg-indigo-600 text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0">
+                {i + 1}
+              </span>
+              <div className="min-w-0">
+                <p className="text-xs font-semibold text-gray-800 dark:text-gray-100 truncate">{q.title}</p>
+                {Number(q.coefficient) !== 1 && <p className="text-[10px] text-gray-400">coef {formatScore(q.coefficient)}</p>}
+              </div>
+            </div>
+          ))}
+          {cumul.quizzes.length > 4 && (
+            <div className="rounded-xl bg-indigo-50 dark:bg-indigo-950/30 text-indigo-700 dark:text-indigo-300 text-xs font-bold flex items-center justify-center py-2">
+              +{cumul.quizzes.length - 4} autre(s)
+            </div>
+          )}
+        </div>
+
+        <p className="text-[11px] text-gray-400">
+          Créé le {formatDate(cumul.created_at, false)} · {cumul.missing_policy === 'zero' ? 'absent = 0' : 'absences ignorées'}
+        </p>
+      </div>
+
+      <div className="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-indigo-100 dark:border-indigo-900/40">
+        <Link
+          href={route('projects.quiz-cumuls.show', [project.id, cumul.id])}
+          className="inline-flex items-center gap-1.5 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold transition"
+        >
+          <FaEye /> Résultats cumulés
+        </Link>
+        <ExportButtons xlsxUrl={exportUrl('xlsx')} pdfUrl={exportUrl('pdf')} compact />
+      </div>
+    </div>
+  );
+}
