+    /** Administrateur global ou responsable actif de ce projet. */
+    public function isManagedBy($user): bool
+    {
+        if (! $user) {
+            return false;
+        }
+
+        if ($user->hasRole('admin')) {
+            return true;
+        }
+
+        return $this->managers()->where('users.id', $user->id)->exists();
