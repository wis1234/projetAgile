@@ -0,0 +1,402 @@
+import React, { useMemo, useState } from 'react';
+import { router } from '@inertiajs/react';
+import AdminLayout from '@/Layouts/AdminLayout';
+import {
+  FaCalculator,
+  FaChevronDown,
+  FaChevronUp,
+  FaCommentDots,
+  FaFire,
+  FaHandsHelping,
+  FaLock,
+  FaPlus,
+  FaSearch,
+  FaStar,
+  FaTrash,
+  FaUsers,
+} from 'react-icons/fa';
+import {
+  Avatar,
+  BackLink,
+  Button,
+  Card,
+  Dialog,
+  Field,
+  Pill,
+  PageShell,
+  ProgressBar,
+  ScoreDisplay,
+  StatCard,
+  inputClass,
+} from '@/Components/Quiz/ui';
+import { formatDate, formatScore } from '@/lib/quiz';
+
+const QUICK_POINTS = [1, 2, 5];
+
+function Participation({ project, quiz, candidates = [], isValidated, sessions = [] }) {
+  const [search, setSearch] = useState('');
+  const [session, setSession] = useState('');
+  const [expanded, setExpanded] = useState(null);
+  const [award, setAward] = useState(null); // candidat ciblé par la fenêtre d'attribution
+  const [form, setForm] = useState({ points: '', reason: '' });
+  const [formError, setFormError] = useState(null);
+  const [busy, setBusy] = useState(false);
+  const [settings, setSettings] = useState({
+    participation_max: quiz.participation_max,
+    participation_weight: quiz.participation_weight,
+  });
+
+  const max = Number(quiz.participation_max);
+  const weight = Number(quiz.participation_weight);
+  const storeUrl = route('projects.quizzes.participation.store', [project.id, quiz.id]);
+
+  const filtered = useMemo(
+    () => candidates.filter((c) => `${c.name} ${c.email || ''}`.toLowerCase().includes(search.toLowerCase())),
+    [candidates, search]
+  );
+
+  const stats = useMemo(() => {
+    const rewarded = candidates.filter((c) => c.total_points > 0);
+    const total = rewarded.reduce((acc, c) => acc + c.total_points, 0);
+    return {
+      rewarded: rewarded.length,
+      total,
+      average: rewarded.length ? total / rewarded.length : 0,
+      top: candidates[0]?.total_points > 0 ? candidates[0] : null,
+    };
+  }, [candidates]);
+
+  const post = (payload, { onSuccess, onError } = {}) => {
+    setBusy(true);
+    router.post(storeUrl, payload, {
+      preserveScroll: true,
+      onSuccess,
+      onError,
+      onFinish: () => setBusy(false),
+    });
+  };
+
+  const quickAward = (candidate, points) =>
+    post({ candidate_key: candidate.key, points, session_label: session || null, reason: null });
+
+  const submitAward = () => {
+    setFormError(null);
+    const points = Number(form.points);
+    if (!form.points || Number.isNaN(points) || points === 0) return setFormError('Indiquez un nombre de points (positif ou négatif).');
+    if (Math.abs(points) > max) return setFormError(`Maximum ${formatScore(max)} points par attribution.`);
+
+    post(
+      { candidate_key: award.key, points, reason: form.reason || null, session_label: session || null },
+      {
+        onSuccess: () => {
+          setAward(null);
+          setForm({ points: '', reason: '' });
+        },
+        onError: (errors) => setFormError(errors.points || errors.candidate_key || errors.reason || 'Attribution impossible.'),
+      }
+    );
+  };
+
+  const removeEntry = (entry) => {
+    if (!confirm('Supprimer cette attribution de points ?')) return;
+    router.delete(route('projects.quizzes.participation.destroy', [project.id, quiz.id, entry.id]), { preserveScroll: true });
+  };
+
+  const saveSettings = () => {
+    setBusy(true);
+    router.put(route('projects.quizzes.participation.settings', [project.id, quiz.id]), settings, {
+      preserveScroll: true,
+      onFinish: () => setBusy(false),
+    });
+  };
+
+  const settingsChanged =
+    Number(settings.participation_max) !== max || Number(settings.participation_weight) !== weight;
+
+  // Exemple concret du calcul, pour que la règle se lise d'un coup d'œil.
+  const example = { quiz: 60, points: max / 2 };
+  const exampleFinal = (example.quiz * (100 - settings.participation_weight) + 50 * settings.participation_weight) / 100;
+
+  return (
+    <PageShell>
+      <Card>
+        <BackLink href={route('projects.quizzes.show', [project.id, quiz.id])}>Retour aux détails du quiz</BackLink>
+        <div className="flex flex-col md:flex-row md:items-center justify-between gap-3 mt-2">
+          <div>
+            <h1 className="text-2xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2.5">
+              <FaHandsHelping className="text-pink-600" /> Points de participation
+            </h1>
+            <p className="text-sm text-gray-500 dark:text-gray-400">
+              Récompensez l'implication pendant les formations — {quiz.title}
+            </p>
+          </div>
+        </div>
+      </Card>
+
+      {isValidated && (
+        <div className="px-5 py-3 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-sm flex items-center gap-2.5">
+          <FaLock /> Les résultats sont validés : rouvrez la délibération pour modifier la participation.
+        </div>
+      )}
+
+      <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
+        <StatCard icon={<FaUsers />} tone="blue" label="Participants récompensés" value={`${stats.rewarded} / ${candidates.length}`} />
+        <StatCard icon={<FaStar />} tone="amber" label="Points attribués" value={formatScore(stats.total)} />
+        <StatCard icon={<FaCalculator />} tone="purple" label="Moyenne par participant" value={formatScore(stats.average)} />
+        <StatCard
+          icon={<FaFire />}
+          tone="red"
+          label="Plus impliqué(e)"
+          value={stats.top ? stats.top.name : '—'}
+          hint={stats.top ? `${formatScore(stats.top.total_points)} pts` : undefined}
+        />
+      </div>
+
+      {/* Règle de calcul */}
+      <Card className="space-y-4">
+        <div className="flex items-start gap-3">
+          <span className="w-10 h-10 rounded-xl bg-pink-50 dark:bg-pink-950/30 text-pink-600 flex items-center justify-center flex-shrink-0">
+            <FaCalculator />
+          </span>
+          <div>
+            <h2 className="text-base font-bold text-gray-900 dark:text-white">Comment ça compte dans la sélection finale</h2>
+            <p className="text-sm text-gray-500 dark:text-gray-400">
+              La participation est ramenée en pourcentage (points ÷ plafond) puis mélangée à la note du quiz selon le poids choisi.
+              Avec un poids de <strong>0 %</strong>, elle est enregistrée mais ne change aucune note.
+            </p>
+          </div>
+        </div>
+
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
+          <Field label="Plafond de points par candidat" hint="Au-delà, les points ne comptent plus.">
+            <input
+              type="number"
+              min="1"
+              max="1000"
+              step="0.5"
+              disabled={isValidated}
+              value={settings.participation_max}
+              onChange={(e) => setSettings((s) => ({ ...s, participation_max: e.target.value }))}
+              className={inputClass}
+            />
+          </Field>
+          <Field label={`Poids dans la note finale : ${settings.participation_weight} %`} hint="0 % = désactivée · 50 % maximum">
+            <input
+              type="range"
+              min="0"
+              max="50"
+              step="5"
+              disabled={isValidated}
+              value={settings.participation_weight}
+              onChange={(e) => setSettings((s) => ({ ...s, participation_weight: Number(e.target.value) }))}
+              className="w-full accent-pink-600"
+            />
+          </Field>
+          <Button variant="primary" onClick={saveSettings} disabled={busy || isValidated || !settingsChanged}>
+            Enregistrer la règle
+          </Button>
+        </div>
+
+        <div className="rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 p-3 text-xs text-gray-600 dark:text-gray-300">
+          <strong>Exemple :</strong> un candidat à {example.quiz} % au quiz avec {formatScore(example.points)} points sur {formatScore(settings.participation_max)} (50 % de participation) obtient{' '}
+          <strong>
+            {example.quiz} × {100 - settings.participation_weight} % + 50 × {settings.participation_weight} % = {formatScore(exampleFinal)} %
+          </strong>
+          .
+        </div>
+      </Card>
+
+      {/* Outils : séance + recherche */}
+      <Card className="grid grid-cols-1 md:grid-cols-2 gap-4">
+        <Field label="Séance en cours (facultatif)" hint="Étiquette ajoutée à chaque attribution rapide (+1, +2, +5).">
+          <input
+            list="participation-sessions"
+            value={session}
+            onChange={(e) => setSession(e.target.value)}
