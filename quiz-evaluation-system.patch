@@ -0,0 +1,23 @@
+<?php
+
+namespace App\Http\Requests;
+
+use App\Http\Requests\Concerns\QuizRules;
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Validation\Validator;
+
+/** Enregistrement d'une seule question (bouton « Enregistrer la question »). */
+class SaveQuestionRequest extends FormRequest
+{
+    use QuizRules;
+
+    public function rules(): array
+    {
+        return $this->questionRules('');
+    }
+
+    public function withValidator(Validator $validator): void
+    {
+        $validator->after(fn ($v) => $this->assertCorrectOptionsFilled($v, [$this->all()], ''));
+    }
+}
