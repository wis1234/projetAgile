new file mode 100644
index 0000000..2adb4d2
--- /dev/null
+++ b/app/Exports/QuizSheetExport.php
@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Exports;
+
+use Maatwebsite\Excel\Concerns\FromArray;
+use Maatwebsite\Excel\Concerns\ShouldAutoSize;
+use Maatwebsite\Excel\Concerns\WithStyles;
+use Maatwebsite\Excel\Concerns\WithTitle;
+use PhpOffice\PhpSpreadsheet\Style\Fill;
+use PhpOffice\PhpSpreadsheet\Worksheet\Worksheet;
+
+/**
+ * Feuille Excel générique : lignes déjà construites + repérage des lignes de titre / d'en-tête.
+ */
+class QuizSheetExport implements FromArray, ShouldAutoSize, WithStyles, WithTitle
+{
+    /**
+     * @param array<int, array<int, mixed>> $rows
+     * @param list<int> $headerRows numéros de ligne (1-based) des en-têtes de tableau
+     * @param list<int> $titleRows  numéros de ligne (1-based) des titres
+     */
+    public function __construct(
+        private array $rows,
+        private string $sheetTitle,
+        private array $headerRows = [],
+        private array $titleRows = [1],
+    ) {
+    }
+
+    public function array(): array
+    {
+        return $this->rows;
+    }
+
+    public function title(): string
+    {
+        // Excel : 31 caractères max, sans \ / ? * [ ] :
+        return mb_substr(preg_replace('/[\\\\\/\?\*\[\]:]/', ' ', $this->sheetTitle), 0, 31);
+    }
+
+    public function styles(Worksheet $sheet): array
+    {
+        $styles = [];
+
+        foreach ($this->titleRows as $row) {
+            $styles[$row] = ['font' => ['bold' => true, 'size' => 14]];
+        }
+
+        foreach ($this->headerRows as $row) {
+            $styles[$row] = [
+                'font' => ['bold' => true, 'color' => ['rgb' => 'FFFFFF']],
+                'fill' => ['fillType' => Fill::FILL_SOLID, 'startColor' => ['rgb' => '2563EB']],
+            ];
+        }
+
+        return $styles;
+    }
+}
