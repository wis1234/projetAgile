diff --git a/app/Http/Controllers/QuizCorrectionController.php b/app/Http/Controllers/QuizCorrectionController.php
new file mode 100644
index 0000000..bd2624f
--- /dev/null
+++ b/app/Http/Controllers/QuizCorrectionController.php
@@ -0,0 +1,141 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizAttempt;
+use App\Services\Quiz\GradingService;
+use App\Services\Quiz\QuizScoring;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Inertia\Inertia;
+
+/**
+ * Espace de correction : plusieurs correcteurs travaillent en même temps sur la même page.
+ * Chaque copie est réservée à un correcteur ; dès qu'elle est notée, la suivante s'affiche.
+ */
+class QuizCorrectionController extends Controller
+{
+    public function __construct(private GradingService $grading)
+    {
+    }
+
+    public function show(Request $request, Project $project, Quiz $quiz)
+    {
+        $this->authorize('grade', [Quiz::class, $project]);
+
+        $user = Auth::user();
+        $hasWritten = $quiz->questions()->where('question_type', 'written')->exists();
+
+        $copy = null;
+        if ($hasWritten && ! $quiz->isValidated()) {
+            $attempt = $this->grading->claim($quiz, $user, $request->integer('attempt') ?: null);
+            $copy = $attempt ? $this->grading->copyPayload($quiz, $attempt) : null;
+        }
+
+        return Inertia::render('Quizzes/Correction', [
+            'project' => ['id' => $project->id, 'name' => $project->name],
+            'quiz' => $quiz->only(['id', 'title', 'deliberation_status']),
+            'hasWritten' => $hasWritten,
+            'isValidated' => $quiz->isValidated(),
+            'writtenMax' => QuizScoring::WRITTEN_MAX,
+            'claimMinutes' => QuizAttempt::CLAIM_TTL_MINUTES,
+            'initialCopy' => $copy,
+            'stats' => $this->grading->stats($quiz, $user),
+            'queue' => $this->grading->queue($quiz, $user),
+        ]);
+    }
+
+    /** Réserve la copie suivante (ou une copie précise). */
+    public function next(Request $request, Project $project, Quiz $quiz): JsonResponse
+    {
+        $this->authorize('grade', [Quiz::class, $project]);
+
+        if ($quiz->isValidated()) {
+            return $this->validatedResponse();
+        }
+
+        $data = $request->validate([
+            'attempt_id' => ['nullable', 'integer'],
+            'exclude' => ['nullable', 'array', 'max:500'],
+            'exclude.*' => ['integer'],
+        ]);
+
+        $user = Auth::user();
+        $attempt = $this->grading->claim($quiz, $user, $data['attempt_id'] ?? null, $data['exclude'] ?? []);
+
+        return response()->json([
+            'copy' => $attempt ? $this->grading->copyPayload($quiz, $attempt) : null,
+            'stats' => $this->grading->stats($quiz, $user),
+            'queue' => $this->grading->queue($quiz, $user),
+        ]);
+    }
+
+    /** Enregistre les notes de la copie puis réserve automatiquement la suivante. */
+    public function save(Request $request, Project $project, Quiz $quiz, QuizAttempt $attempt): JsonResponse
+    {
+        $this->authorize('grade', [Quiz::class, $project]);
+
+        if ($quiz->isValidated()) {
+            return $this->validatedResponse();
+        }
+
+        $data = $request->validate([
+            'grades' => ['required', 'array', 'min:1', 'max:200'],
+            'grades.*.question_id' => ['required', 'integer'],
+            'grades.*.score' => ['required', 'numeric', 'min:0', 'max:' . QuizScoring::WRITTEN_MAX],
+            'grades.*.admin_comments' => ['nullable', 'string', 'max:2000'],
+        ]);
+
+        $user = Auth::user();
+
+        // La réservation a pu expirer : on tente de la reprendre, sinon un autre correcteur a la main.
+        if (! $this->grading->holdsClaim($attempt, $user) && ! $this->grading->claim($quiz, $user, $attempt->id)) {
+            return response()->json([
+                'message' => 'Cette copie est en cours de correction par un autre correcteur.',
+            ], 409);
+        }
+
+        try {
+            $result = $this->grading->gradeCopy($quiz, $attempt, $data['grades'], $user);
+        } catch (\InvalidArgumentException $e) {
+            return response()->json(['message' => $e->getMessage()], 422);
+        }
+
+        if (function_exists('activity_log')) {
+            activity_log('update', "Copie n° {$attempt->id} du quiz '{$quiz->title}' corrigée par {$user->name} (note : " . QuizScoring::format($result->score) . '%)', $quiz);
+        }
+
+        $stats = $this->grading->stats($quiz, $user);
+        $next = $this->grading->claim($quiz, $user);
+
+        return response()->json([
+            'saved' => true,
+            'result' => ['score' => $result->score, 'grading_status' => $result->grading_status],
+            'copy' => $next ? $this->grading->copyPayload($quiz, $next) : null,
+            'stats' => $this->grading->stats($quiz, $user),
+            'queue' => $this->grading->queue($quiz, $user),
+            // Vrai uniquement quand plus aucune copie n'attend de correction, chez personne.
+            'all_done' => $stats['pending'] === 0 && $next === null,
+        ]);
+    }
+
+    /** Libère la copie (bouton « Passer » ou fermeture de la page). */
+    public function release(Project $project, Quiz $quiz, QuizAttempt $attempt): JsonResponse
+    {
+        $this->authorize('grade', [Quiz::class, $project]);
+
+        $this->grading->release($attempt, Auth::user());
+
+        return response()->json(['released' => true]);
+    }
+
+    private function validatedResponse(): JsonResponse
+    {
+        return response()->json([
+            'message' => 'Les résultats de ce quiz sont validés. Rouvrez la délibération pour modifier une note.',
+        ], 423);
+    }
+}
