+                      <span className="block truncate" title={c.title}>{c.title}</span>
+                      <span className="block text-[10px] font-normal normal-case text-gray-400">coef {formatScore(c.coefficient)}</span>
+                    </th>
+                  ))}
+                  <th className="px-2 py-3 text-right">Moyenne</th>
+                  <th className="px-4 sm:px-6 py-3 text-right">Résultat</th>
+                  <th className="w-10" />
+                </tr>
+              </thead>
+              <tbody className="divide-y divide-gray-100 dark:divide-gray-700">
+                {filtered.map((r) => {
+                  const tone = scoreTone(r.average, false, passMark);
+                  const expanded = open === r.key;
+                  return (
+                    <React.Fragment key={r.key}>
+                      <tr className="hover:bg-gray-50/70 dark:hover:bg-gray-700/30">
+                        <td className="px-4 sm:px-6 py-3 font-bold text-gray-500">#{r.rank}</td>
+                        <td className="px-2 py-3">
+                          <div className="flex items-center gap-3 min-w-0">
+                            <Avatar name={r.name} src={r.photo} size="sm" />
+                            <span className="font-semibold text-gray-900 dark:text-white truncate">{r.name}</span>
+                          </div>
+                        </td>
+                        {columns.map((c) => (
+                          <td key={c.id} className="px-2 py-3 text-right text-gray-600 dark:text-gray-300">
+                            {r.scores[c.id] !== undefined ? (
+                              <>
+                                {formatScore(r.scores[c.id])}
+                                {r.bonus?.[c.id] > 0 && <span className="block text-[10px] text-pink-500">dont +{formatScore(r.bonus[c.id])} pt particip.</span>}
+                              </>
+                            ) : (
+                              <span className="text-gray-300 dark:text-gray-600">Absent</span>
+                            )}
+                          </td>
+                        ))}
+                        <td className={`px-2 py-3 text-right font-extrabold text-base ${TONES[tone].text}`}>{formatScore(r.average)} %</td>
+                        <td className="px-4 sm:px-6 py-3 text-right">
+                          <Pill tone={tone}>{r.passed ? 'Admis' : 'Ajourné'}</Pill>
+                        </td>
+                        <td className="pr-3">
+                          <button
+                            type="button"
+                            onClick={() => setOpen(expanded ? null : r.key)}
+                            className="p-2 text-gray-400 hover:text-indigo-600 rounded-lg print:hidden"
+                            title="Voir le calcul"
+                            aria-expanded={expanded}
+                          >
+                            {expanded ? <FaChevronUp /> : <FaChevronDown />}
+                          </button>
+                        </td>
+                      </tr>
+                      {expanded && (
+                        <tr className="bg-indigo-50/50 dark:bg-indigo-950/20">
+                          <td colSpan={columns.length + 5} className="px-6 py-3 text-sm text-indigo-900 dark:text-indigo-200">
