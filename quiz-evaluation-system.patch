new file mode 100644
index 0000000..9c102bc
--- /dev/null
+++ b/app/Http/Requests/Concerns/QuizRules.php
@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Http\Requests\Concerns;
+
+use Illuminate\Validation\Validator;
+
+/**
+ * Règles de validation partagées entre la création, la modification
+ * et l'enregistrement question par question.
+ */
+trait QuizRules
+{
+    public function authorize(): bool
+    {
+        // L'autorisation métier est vérifiée dans les contrôleurs (policies).
+        return true;
+    }
+
+    protected function settingsRules(): array
+    {
+        return [
+            'title' => ['required', 'string', 'max:255'],
+            'description' => ['nullable', 'string', 'max:5000'],
+            'duration_minutes' => ['required', 'integer', 'min:1', 'max:360'],
+            'max_attempts' => ['required', 'integer', 'min:1', 'max:100'],
+            'is_active' => ['sometimes', 'boolean'],
+            'show_results' => ['sometimes', 'boolean'],
+        ];
+    }
+
+    /**
+     * @param string $prefix '' (question seule), 'question.' ou 'questions.*.'
+     */
+    protected function questionRules(string $prefix = ''): array
+    {
+        $type = $prefix . 'question_type';
+
+        return [
+            $prefix . 'id' => ['nullable', 'integer'],
+            $prefix . 'question_text' => ['required', 'string', 'max:5000'],
+            $type => ['required', 'in:qcm,written'],
+            $prefix . 'option_a' => ['nullable', 'required_if:' . $type . ',qcm', 'string', 'max:500'],
+            $prefix . 'option_b' => ['nullable', 'required_if:' . $type . ',qcm', 'string', 'max:500'],
+            $prefix . 'option_c' => ['nullable', 'string', 'max:500'],
+            $prefix . 'option_d' => ['nullable', 'string', 'max:500'],
+            $prefix . 'correct_answer' => ['nullable', 'required_if:' . $type . ',qcm', 'integer', 'in:0,1,2,3'],
+            $prefix . 'position' => ['nullable', 'integer', 'min:1', 'max:1000'],
+        ];
+    }
+
+    /**
+     * La bonne réponse d'un QCM doit désigner une option réellement renseignée.
+     *
+     * @param array<int|string, array<string, mixed>> $questions
+     */
+    protected function assertCorrectOptionsFilled(Validator $validator, array $questions, string $path): void
+    {
+        foreach ($questions as $index => $q) {
+            if (($q['question_type'] ?? null) !== 'qcm' || ! isset($q['correct_answer'])) {
+                continue;
+            }
+
+            $letter = ['a', 'b', 'c', 'd'][(int) $q['correct_answer']] ?? null;
+            if ($letter && trim((string) ($q['option_' . $letter] ?? '')) === '') {
+                $key = str_replace('*', (string) $index, $path) . 'correct_answer';
+                $validator->errors()->add($key, 'La bonne réponse doit correspondre à une option renseignée.');
+            }
+        }
+    }
+}
diff --git a/app/Http/Requests/SaveQuestionRequest.php b/app/Http/Requests/SaveQuestionRequest.php
