+
+/** Saisie de la note : curseur + valeur + notes rapides, par demi-points. */
+function ScoreControl({ value, max, onChange }) {
+  const hasValue = value !== null && value !== undefined && value !== '';
+  const numeric = hasValue ? Number(value) : 0;
+
+  return (
+    <div className="rounded-xl bg-purple-50/60 dark:bg-purple-950/20 border border-purple-100 dark:border-purple-900/40 p-4 space-y-3">
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-xs font-bold uppercase text-purple-700 dark:text-purple-300">Note</span>
+        <div className="flex items-center gap-2">
+          <input
+            type="number"
+            min="0"
+            max={max}
+            step="0.5"
+            value={hasValue ? value : ''}
+            onChange={(e) => {
+              if (e.target.value === '') return onChange(null);
+              onChange(Math.max(0, Math.min(max, Number(e.target.value))));
+            }}
+            placeholder="—"
+            className="w-20 text-center text-lg font-extrabold rounded-xl border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:text-white focus:border-purple-500 focus:ring-purple-500"
+            aria-label="Note sur 10"
+          />
+          <span className="text-sm font-semibold text-gray-500">/ {max}</span>
+        </div>
+      </div>
+
+      <input
+        type="range"
+        min="0"
+        max={max}
+        step="0.5"
+        value={numeric}
+        onChange={(e) => onChange(Number(e.target.value))}
+        className="w-full accent-purple-600"
+        aria-label="Curseur de note"
+      />
+
+      <div className="flex flex-wrap gap-1.5">
+        {QUICK_SCORES.filter((s) => s <= max).map((s) => (
+          <button
+            key={s}
+            type="button"
+            onClick={() => onChange(s)}
+            className={`min-w-[2.5rem] px-2.5 py-1 rounded-lg text-xs font-bold transition ${
+              hasValue && numeric === s
+                ? 'bg-purple-600 text-white'
+                : 'bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-600 hover:border-purple-400'
+            }`}
+          >
+            {s}
+          </button>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+Correction.layout = (page) => <AdminLayout>{page}</AdminLayout>;
+export default Correction;
