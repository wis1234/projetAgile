+                  )}
+                </div>
+                <div className="min-w-0">
+                  <p className="text-sm font-bold text-gray-900 dark:text-white truncate">{d.name}</p>
+                  <p className={`text-xs ${d.approved ? 'text-emerald-700 dark:text-emerald-300' : 'text-gray-500 dark:text-gray-400'}`}>
+                    {d.approved ? `Aval donné le ${formatDate(d.approved_at)}` : 'En attente de son aval'}
+                  </p>
+                </div>
+              </li>
