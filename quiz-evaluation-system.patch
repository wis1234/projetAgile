diff --git a/app/Services/Quiz/CumulService.php b/app/Services/Quiz/CumulService.php
new file mode 100644
index 0000000..b8acbc3
--- /dev/null
+++ b/app/Services/Quiz/CumulService.php
@@ -0,0 +1,160 @@
+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Quiz;
+use App\Models\QuizCumul;
+use App\Models\QuizResult;
+use Illuminate\Support\Collection;
+
+/**
+ * Cumul de plusieurs quiz : moyenne (pondérée par coefficient) de la note finale
+ * de chaque candidat dans les quiz sélectionnés.
+ */
+class CumulService
+{
+    public function __construct(private ResultsService $results)
+    {
+    }
+
+    /** Nombre de copies écrites encore à corriger par quiz. */
+    public function pendingCounts(Collection $quizIds): array
+    {
+        return QuizResult::whereIn('quiz_id', $quizIds)
+            ->where('grading_status', QuizResult::STATUS_PENDING)
+            ->selectRaw('quiz_id, COUNT(*) as pending')
+            ->groupBy('quiz_id')
+            ->pluck('pending', 'quiz_id')
+            ->all();
+    }
+
+    /**
+     * @param array<int, float> $coefficients quiz_id => coefficient (ordre = ordre des colonnes)
+     * @return array<string, mixed>
+     */
+    public function compute(array $coefficients, string $missingPolicy = QuizCumul::MISSING_ZERO, int $passMark = QuizScoring::PASS_MARK): array
+    {
+        $quizIds = array_keys($coefficients);
+        $quizzes = Quiz::whereIn('id', $quizIds)->get()->keyBy('id');
+
+        $columns = [];
+        $candidates = [];
+
+        foreach ($quizIds as $quizId) {
+            $quiz = $quizzes->get($quizId);
+            if (! $quiz) {
+                continue;
+            }
+
+            $columns[] = [
+                'id' => $quiz->id,
+                'title' => $quiz->title,
+                'coefficient' => (float) $coefficients[$quizId],
+                'validated' => $quiz->isValidated(),
+                'participation_weight' => (int) $quiz->participation_weight,
+            ];
+
+            foreach ($this->results->candidateRows($quiz) as $row) {
+                $candidates[$row['key']] ??= [
+                    'key' => $row['key'],
+                    'user_id' => $row['user_id'],
+                    'name' => $row['name'],
+                    'email' => $row['email'],
+                    'photo' => $row['photo'],
+                    'is_guest' => $row['is_guest'],
+                    'scores' => [],
+                    'bonus' => [],
+                ];
+                $candidates[$row['key']]['scores'][$quiz->id] = $row['final_score'];
+                $candidates[$row['key']]['bonus'][$quiz->id] = $row['participation_points'];
+            }
+        }
+
+        $rows = collect($candidates)->map(function (array $c) use ($columns, $missingPolicy) {
+            return array_merge($c, $this->average($c['scores'], $columns, $missingPolicy));
+        });
+
+        $rows = $this->results->rank($rows->map(function (array $r) {
+            // rank() s'appuie sur final_score / completed_at
+            $r['final_score'] = $r['average'];
+            $r['completed_at'] = null;
+
+            return $r;
+        })->values())->map(function (array $r) use ($passMark) {
+            $r['passed'] = QuizScoring::isPassed($r['average'], $passMark);
+
+            return $r;
+        });
+
+        return [
+            'columns' => $columns,
+            'rows' => $rows->values()->all(),
+            'summary' => $this->summarize($rows, $passMark),
+            'missing_policy' => $missingPolicy,
+            'pass_mark' => $passMark,
+        ];
+    }
+
+    /**
+     * @param array<int, float> $scores quiz_id => note
+     * @return array{average: float, calculation: string, missing_count: int}
+     */
+    public function average(array $scores, array $columns, string $missingPolicy): array
+    {
+        $terms = [];
+        $sum = 0.0;
+        $weightSum = 0.0;
+        $missing = 0;
+
+        foreach ($columns as $col) {
+            $coef = $col['coefficient'];
+            $has = array_key_exists($col['id'], $scores);
+
+            if (! $has) {
+                $missing++;
+                if ($missingPolicy === QuizCumul::MISSING_IGNORE) {
+                    continue;
+                }
+            }
+
+            $value = $has ? (float) $scores[$col['id']] : 0.0;
+            $sum += $value * $coef;
+            $weightSum += $coef;
+            $terms[] = ['value' => $value, 'coef' => $coef];
+        }
+
+        $average = $weightSum > 0 ? round($sum / $weightSum, 2) : 0.0;
+
+        $allCoefOne = collect($terms)->every(fn ($t) => (float) $t['coef'] === 1.0);
+        $numerator = collect($terms)->map(fn ($t) => $allCoefOne
+            ? QuizScoring::format($t['value'])
+            : QuizScoring::format($t['value']) . '×' . QuizScoring::format($t['coef'])
+        )->implode(' + ');
+        $denominator = $allCoefOne ? (string) count($terms) : QuizScoring::format($weightSum);
+
+        $calculation = $terms
+            ? '(' . $numerator . ') ÷ ' . $denominator . ' = ' . QuizScoring::format($average)
+            : 'Aucune note disponible';
+
+        return [
+            'average' => $average,
+            'calculation' => $calculation,
+            'missing_count' => $missing,
+        ];
+    }
+
+    private function summarize(Collection $rows, int $passMark): array
+    {
+        $count = $rows->count();
+
+        return [
+            'count' => $count,
+            'average' => $count ? round($rows->avg('average'), 2) : null,
+            'highest' => $count ? $rows->max('average') : null,
+            'lowest' => $count ? $rows->min('average') : null,
+            'passed_count' => $rows->where('passed', true)->count(),
+            'pass_rate' => $count ? round($rows->where('passed', true)->count() / $count * 100, 1) : null,
+            'pass_mark' => $passMark,
+        ];
+    }
+}
diff --git a/app/Services/Quiz/DeliberationService.php b/app/Services/Quiz/DeliberationService.php
new file mode 100644
index 0000000..5ef40fa
--- /dev/null
+++ b/app/Services/Quiz/DeliberationService.php
@@ -0,0 +1,166 @@
+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Quiz;
+use App\Models\QuizDeliberationApproval;
+use App\Models\QuizResult;
+use App\Models\User;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Délibération : chaque responsable du projet donne son aval (avec son mot de passe).
+ * Quand tous ont approuvé, les résultats sont validés et le quiz est clôturé.
+ * Toute modification de note invalide les avals déjà donnés.
+ */
+class DeliberationService
+{
+    /** Responsables habilités à décider pour ce quiz. */
+    public function deciders(Quiz $quiz): Collection
+    {
+        return $quiz->project->managers()
+            ->orderBy('users.name')
+            ->get(['users.id', 'users.name', 'users.email', 'users.profile_photo_path']);
+    }
+
+    public function canApprove(User $user, Quiz $quiz): bool
+    {
+        $deciders = $this->deciders($quiz);
+
+        if ($deciders->isEmpty()) {
+            // Projet sans responsable : un administrateur peut valider seul.
+            return $user->hasRole('admin');
+        }
+
+        return $deciders->contains('id', $user->id);
+    }
+
+    public function pendingCopies(Quiz $quiz): int
+    {
+        return QuizResult::where('quiz_id', $quiz->id)
+            ->where('grading_status', QuizResult::STATUS_PENDING)
+            ->count();
+    }
+
+    /** @return list<string> raisons pour lesquelles la délibération n'est pas encore possible */
+    public function blockers(Quiz $quiz): array
+    {
+        $blockers = [];
+
+        if (! QuizResult::where('quiz_id', $quiz->id)->exists()) {
+            $blockers[] = 'Aucun candidat n\'a encore terminé ce quiz.';
+        }
+
+        $pending = $this->pendingCopies($quiz);
+        if ($pending > 0) {
+            $blockers[] = $pending . ' copie(s) restent à corriger.';
+        }
+
+        return $blockers;
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    public function summary(Quiz $quiz, ?User $viewer = null): array
+    {
+        $deciders = $this->deciders($quiz);
+        $approvals = $quiz->approvals()->get()->keyBy('user_id');
+
+        $list = $deciders->map(fn (User $u) => [
+            'id' => $u->id,
+            'name' => $u->name,
+            'photo' => $u->profile_photo_url,
+            'approved' => $approvals->has($u->id),
+            'approved_at' => $approvals->get($u->id)?->approved_at?->toIso8601String(),
+        ])->values();
+
+        // Cas sans responsable : on affiche les administrateurs qui ont approuvé.
+        if ($deciders->isEmpty() && $approvals->isNotEmpty()) {
+            $list = User::whereIn('id', $approvals->keys())->get()->map(fn (User $u) => [
+                'id' => $u->id,
+                'name' => $u->name,
+                'photo' => $u->profile_photo_url,
+                'approved' => true,
+                'approved_at' => $approvals->get($u->id)?->approved_at?->toIso8601String(),
+            ])->values();
+        }
+
+        $required = $deciders->isEmpty() ? 1 : $deciders->count();
+        $approved = $deciders->isEmpty()
+            ? $approvals->count()
+            : $deciders->filter(fn ($u) => $approvals->has($u->id))->count();
+
+        return [
+            'status' => $quiz->deliberation_status,
+            'validated_at' => $quiz->validated_at?->toIso8601String(),
+            'blockers' => $this->blockers($quiz),
+            'deciders' => $list,
+            'approved_count' => min($approved, $required),
+            'required_count' => $required,
+            'viewer_can_approve' => $viewer ? $this->canApprove($viewer, $quiz) : false,
+            'viewer_has_approved' => $viewer ? $approvals->has($viewer->id) : false,
+        ];
+    }
+
+    /**
+     * Enregistre l'aval d'un responsable. Retourne true si le quiz vient d'être validé.
+     *
+     * @throws \DomainException si la délibération n'est pas possible
+     */
+    public function approve(Quiz $quiz, User $user, ?string $ip = null): bool
+    {
+        return DB::transaction(function () use ($quiz, $user, $ip) {
+            $quiz = Quiz::whereKey($quiz->id)->lockForUpdate()->firstOrFail();
+
+            if ($quiz->isValidated()) {
+                throw new \DomainException('Les résultats de ce quiz sont déjà validés.');
+            }
+
+            $blockers = $this->blockers($quiz);
+            if ($blockers) {
+                throw new \DomainException($blockers[0]);
+            }
+
+            if (! $this->canApprove($user, $quiz)) {
+                throw new \DomainException('Seuls les responsables du projet peuvent donner leur aval.');
+            }
+
+            QuizDeliberationApproval::firstOrCreate(
+                ['quiz_id' => $quiz->id, 'user_id' => $user->id],
+                ['approved_at' => now(), 'ip_address' => $ip]
+            );
+
+            $summary = $this->summary($quiz);
+            if ($summary['approved_count'] >= $summary['required_count']) {
+                $quiz->forceFill([
+                    'deliberation_status' => Quiz::DELIBERATION_VALIDATED,
+                    'validated_at' => now(),
+                ])->save();
+
+                return true;
+            }
+
+            return false;
+        });
+    }
+
+    /**
+     * Annule les avals (une note a changé, ou un responsable rouvre la délibération).
+     */
+    public function invalidate(Quiz $quiz): void
+    {
+        $hadApprovals = $quiz->approvals()->exists();
+
+        if (! $hadApprovals && ! $quiz->isValidated()) {
+            return;
+        }
+
+        $quiz->approvals()->delete();
+        $quiz->forceFill([
+            'deliberation_status' => Quiz::DELIBERATION_OPEN,
+            'validated_at' => null,
+        ])->save();
+    }
+}
diff --git a/app/Services/Quiz/ExportBuilder.php b/app/Services/Quiz/ExportBuilder.php
new file mode 100644
index 0000000..5898519
--- /dev/null
+++ b/app/Services/Quiz/ExportBuilder.php
@@ -0,0 +1,159 @@
+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizCumul;
+
+/**
+ * Prépare les données (et les lignes Excel) des exports de résultats.
+ */
+class ExportBuilder
+{
+    public function __construct(
+        private ResultsService $results,
+        private DeliberationService $deliberation,
+    ) {
+    }
+
+    // ------------------------------------------------------------------
+    // Résultats d'un quiz
+    // ------------------------------------------------------------------
+
+    /** @return array<string, mixed> */
+    public function quizData(Project $project, Quiz $quiz): array
+    {
+        $rows = $this->results->candidateRows($quiz);
+        $approvals = $quiz->approvals()->with('user:id,name')->orderBy('approved_at')->get();
+
+        return [
+            'title' => 'Résultats finaux — ' . $quiz->title,
+            'project' => $project->name,
+            'quiz' => $quiz->title,
+            'generated_at' => now()->format('d/m/Y à H:i'),
+            'validated' => $quiz->isValidated(),
+            'validated_at' => $quiz->validated_at?->format('d/m/Y à H:i'),
+            'approvers' => $approvals->map(fn ($a) => [
+                'name' => $a->user?->name ?? 'Responsable',
+                'at' => $a->approved_at?->format('d/m/Y à H:i'),
+            ])->all(),
+            'weight' => (int) $quiz->participation_weight,
+            'participation_max' => (float) $quiz->participation_max,
+            'has_participation' => $quiz->participation_weight > 0 || $rows->sum('participation_points') > 0,
+            'pass_mark' => QuizScoring::PASS_MARK,
+            'summary' => $this->results->summary($rows),
+            'rows' => $rows->values()->all(),
+        ];
+    }
+
+    /** @return array{0: array<int, array<int, mixed>>, 1: list<int>, 2: list<int>} rows, headerRows, titleRows */
+    public function quizSheet(array $d): array
+    {
+        $rows = [];
+        $rows[] = [$d['title']];
+        $rows[] = ['Projet', $d['project']];
+        $rows[] = ['Édité le', $d['generated_at']];
+        $rows[] = ['Statut', $d['validated']
+            ? 'VALIDÉ le ' . $d['validated_at'] . ' par ' . implode(', ', array_column($d['approvers'], 'name'))
+            : 'PROVISOIRE — délibération non terminée'];
+        if ($d['has_participation']) {
+            $rows[] = ['Participation', 'Poids ' . $d['weight'] . ' % de la note finale (plafond ' . QuizScoring::format($d['participation_max']) . ' pts)'];
+        }
+        $rows[] = ['Seuil de réussite', $d['pass_mark'] . ' %'];
+        $rows[] = [];
+
+        $s = $d['summary'];
+        $rows[] = ['Candidats', $s['count'], 'Moyenne', $s['average'], 'Meilleure', $s['highest'], 'Plus basse', $s['lowest'], 'Taux de réussite', $s['pass_rate'] !== null ? $s['pass_rate'] . ' %' : ''];
+        $rows[] = [];
+
+        $header = ['Rang', 'Candidat', 'E-mail', 'Note du quiz (%)'];
+        if ($d['has_participation']) {
+            $header = array_merge($header, ['Points participation', 'Participation (%)']);
+        }
+        $header = array_merge($header, ['Note finale (%)', 'Résultat']);
+        $rows[] = $header;
+        $headerRow = count($rows);
+
+        foreach ($d['rows'] as $r) {
+            $line = [$r['pending'] ? '—' : $r['rank'], $r['name'], $r['email'] ?? '', $r['quiz_score']];
+            if ($d['has_participation']) {
+                $line = array_merge($line, [$r['participation_points'], $r['participation_percent']]);
+            }
+            $line[] = $r['final_score'];
+            $line[] = $r['pending'] ? 'En attente de correction' : (QuizScoring::isPassed($r['final_score'], $d['pass_mark']) ? 'Admis' : 'Ajourné');
+            $rows[] = $line;
+        }
+
+        if ($d['approvers']) {
+            $rows[] = [];
+            $rows[] = ['Avals de délibération'];
+            $approvalTitleRow = count($rows);
+            foreach ($d['approvers'] as $a) {
+                $rows[] = [$a['name'], $a['at']];
+            }
+
+            return [$rows, [$headerRow], [1, $approvalTitleRow]];
+        }
+
+        return [$rows, [$headerRow], [1]];
+    }
+
+    // ------------------------------------------------------------------
+    // Cumul
+    // ------------------------------------------------------------------
+
+    /** @return array<string, mixed> */
+    public function cumulData(Project $project, QuizCumul $cumul, array $computed): array
+    {
+        return [
+            'title' => 'Résultats cumulés — ' . $cumul->title,
+            'cumul' => $cumul->title,
+            'description' => $cumul->description,
+            'project' => $project->name,
+            'generated_at' => now()->format('d/m/Y à H:i'),
+            'columns' => $computed['columns'],
+            'rows' => $computed['rows'],
+            'summary' => $computed['summary'],
+            'missing_policy' => $computed['missing_policy'],
+            'pass_mark' => $computed['pass_mark'],
+            'all_validated' => collect($computed['columns'])->every(fn ($c) => $c['validated']),
+        ];
+    }
+
+    /** @return array{0: array<int, array<int, mixed>>, 1: list<int>, 2: list<int>} */
+    public function cumulSheet(array $d): array
+    {
+        $rows = [];
+        $rows[] = [$d['title']];
+        $rows[] = ['Projet', $d['project']];
+        $rows[] = ['Édité le', $d['generated_at']];
+        $rows[] = ['Mode de calcul', 'Moyenne pondérée par les coefficients — ' . ($d['missing_policy'] === QuizCumul::MISSING_ZERO
+            ? 'un quiz non passé compte 0'
+            : 'les quiz non passés sont ignorés')];
+        $rows[] = ['Statut', $d['all_validated'] ? 'Tous les quiz sont validés' : 'PROVISOIRE — certains quiz ne sont pas encore validés'];
+        $rows[] = ['Seuil de réussite', $d['pass_mark'] . ' %'];
+        $rows[] = [];
+
+        $header = ['Rang', 'Candidat', 'E-mail'];
+        foreach ($d['columns'] as $c) {
+            $header[] = $c['title'] . ' (coef ' . QuizScoring::format($c['coefficient']) . ')';
+        }
+        $header = array_merge($header, ['Moyenne générale (%)', 'Résultat', 'Détail du calcul']);
+        $rows[] = $header;
+        $headerRow = count($rows);
+
+        foreach ($d['rows'] as $r) {
+            $line = [$r['rank'], $r['name'], $r['email'] ?? ''];
+            foreach ($d['columns'] as $c) {
+                $line[] = $r['scores'][$c['id']] ?? 'Absent';
+            }
+            $line[] = $r['average'];
+            $line[] = $r['passed'] ? 'Admis' : 'Ajourné';
+            $line[] = $r['calculation'];
+            $rows[] = $line;
+        }
+
+        return [$rows, [$headerRow], [1]];
+    }
+}
diff --git a/app/Services/Quiz/GradingService.php b/app/Services/Quiz/GradingService.php
new file mode 100644
index 0000000..9e504e7
--- /dev/null
+++ b/app/Services/Quiz/GradingService.php
@@ -0,0 +1,412 @@
+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Quiz;
+use App\Models\QuizAttempt;
+use App\Models\QuizResponse;
+use App\Models\QuizResult;
+use App\Models\User;
+use App\Notifications\QuizNotification;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Soumission des copies, calcul des notes et correction des questions écrites.
+ */
+class GradingService
+{
+    public function __construct(private DeliberationService $deliberation)
+    {
+    }
+
+    // ------------------------------------------------------------------
+    // Soumission (membres et candidats externes)
+    // ------------------------------------------------------------------
+
+    /**
+     * Termine une tentative : corrige automatiquement les QCM, enregistre les réponses écrites
+     * et crée le résultat. Idempotent : soumettre deux fois ne crée pas de doublon.
+     */
+    public function submitAttempt(Quiz $quiz, QuizAttempt $attempt, array $answers, ?array $cheatingLogs = null): QuizResult
+    {
+        return DB::transaction(function () use ($quiz, $attempt, $answers, $cheatingLogs) {
+            $attempt = QuizAttempt::whereKey($attempt->id)->lockForUpdate()->firstOrFail();
+
+            if ($attempt->status === 'completed') {
+                return QuizResult::where('attempt_id', $attempt->id)->firstOrFail();
+            }
+
+            $questions = $quiz->questions()->get();
+            $qcm = $questions->where('question_type', 'qcm');
+            $written = $questions->where('question_type', 'written');
+
+            $qcmEarned = 0;
+            foreach ($qcm as $q) {
+                $value = $answers[$q->id] ?? null;
+                if (is_numeric($value) && (int) $value === (int) $q->correct_answer) {
+                    $qcmEarned++;
+                }
+            }
+
+            $pendingWritten = 0;
+            foreach ($written as $q) {
+                $raw = $answers[$q->id] ?? null;
+                $text = is_string($raw) ? $raw : '';
+                $blank = trim($text) === '';
+
+                if (! $blank) {
+                    $pendingWritten++;
+                }
+
+                QuizResponse::updateOrCreate(
+                    ['attempt_id' => $attempt->id, 'question_id' => $q->id],
+                    [
+                        'quiz_id' => $quiz->id,
+                        'user_id' => $attempt->user_id,
+                        'guest_name' => $attempt->guest_name,
+                        'guest_email' => $attempt->guest_email,
+                        'answer_text' => $text,
+                        // Une réponse vide est notée 0 automatiquement : aucun correcteur n'a à la lire.
+                        'grading_status' => $blank ? 'graded' : 'pending',
+                        'score' => $blank ? 0 : null,
+                        'admin_comments' => $blank ? 'Aucune réponse rédigée (note automatique).' : null,
+                        'graded_by' => null,
+                        'graded_at' => $blank ? now() : null,
+                    ]
+                );
+            }
+
+            $qcmPercent = $qcm->count() ? QuizScoring::percent($qcmEarned, $qcm->count()) : null;
+            $writtenPercent = $written->count() ? 0.0 : null; // les points écrits arrivent à la correction
+
+            $attempt->update([
+                'answers' => $answers,
+                'cheating_logs' => $cheatingLogs ?? $attempt->cheating_logs,
+                'status' => 'completed',
+                'completed_at' => now(),
+                'grading_claimed_by' => null,
+                'grading_claimed_at' => null,
+            ]);
+
+            $result = QuizResult::updateOrCreate(
+                ['attempt_id' => $attempt->id],
+                [
+                    'quiz_id' => $quiz->id,
+                    'user_id' => $attempt->user_id,
+                    'guest_name' => $attempt->guest_name,
+                    'guest_email' => $attempt->guest_email,
+                    'score' => QuizScoring::combine($qcmPercent, $writtenPercent),
+                    'correct_answers' => $qcmEarned,
+                    'total_questions' => $questions->count(),
+                    'grading_status' => $pendingWritten > 0 ? QuizResult::STATUS_PENDING : QuizResult::STATUS_GRADED,
+                    'completed_at' => now(),
+                ]
+            );
+
+            // Un nouveau résultat change le classement : les avals déjà donnés ne sont plus valables.
+            $this->deliberation->invalidate($quiz);
+
+            return $result;
+        });
+    }
+
+    // ------------------------------------------------------------------
+    // Calcul
+    // ------------------------------------------------------------------
+
+    /** Recalcule la note et le statut d'un résultat à partir des réponses notées. */
+    public function recalculate(QuizAttempt $attempt, ?Quiz $quiz = null): QuizResult
+    {
+        $quiz ??= $attempt->quiz;
+        $result = QuizResult::where('attempt_id', $attempt->id)->firstOrFail();
+
+        $questions = $quiz->questions()->get();
+        $qcmTotal = $questions->where('question_type', 'qcm')->count();
+        $written = $questions->where('question_type', 'written');
+
+        $responses = QuizResponse::where('attempt_id', $attempt->id)->get()->keyBy('question_id');
+
+        $writtenEarned = 0.0;
+        $pending = 0;
+        foreach ($written as $q) {
+            $response = $responses->get($q->id);
+            if (! $response || $response->grading_status !== 'graded') {
+                $pending++;
+                continue;
+            }
+            $writtenEarned += (float) $response->score;
+        }
+
+        $qcmPercent = $qcmTotal ? QuizScoring::percent($result->correct_answers, $qcmTotal) : null;
+        $writtenPercent = $written->count()
+            ? QuizScoring::percent($writtenEarned, $written->count() * QuizScoring::WRITTEN_MAX)
+            : null;
+
+        $result->update([
+            'score' => QuizScoring::combine($qcmPercent, $writtenPercent),
+            'grading_status' => $pending > 0 ? QuizResult::STATUS_PENDING : QuizResult::STATUS_GRADED,
+        ]);
+
+        return $result->refresh();
+    }
+
+    // ------------------------------------------------------------------
+    // Correction d'une copie
+    // ------------------------------------------------------------------
+
+    /**
+     * Enregistre les notes de toutes les questions écrites d'une copie.
+     *
+     * @param array<int, array{question_id:int, score:float|int|string, admin_comments?:?string}> $grades
+     */
+    public function gradeCopy(Quiz $quiz, QuizAttempt $attempt, array $grades, User $grader): QuizResult
+    {
+        $pendingBefore = $this->deliberation->pendingCopies($quiz);
+
+        $result = DB::transaction(function () use ($quiz, $attempt, $grades, $grader) {
+            $written = $quiz->questions()->where('question_type', 'written')->get();
+            $byQuestion = collect($grades)->keyBy(fn ($g) => (int) $g['question_id']);
+
+            foreach ($written as $q) {
+                $grade = $byQuestion->get($q->id);
+                if ($grade === null || ! is_numeric($grade['score'] ?? null)) {
+                    throw new \InvalidArgumentException('Chaque question écrite doit recevoir une note.');
+                }
+
+                $response = QuizResponse::firstOrNew([
+                    'attempt_id' => $attempt->id,
+                    'question_id' => $q->id,
+                ]);
+
+                if (! $response->exists) {
+                    $response->fill([
+                        'quiz_id' => $quiz->id,
+                        'user_id' => $attempt->user_id,
+                        'guest_name' => $attempt->guest_name,
+                        'guest_email' => $attempt->guest_email,
+                        'answer_text' => is_string($attempt->answers[$q->id] ?? null) ? $attempt->answers[$q->id] : '',
+                    ]);
+                }
+
+                $comment = isset($grade['admin_comments']) ? trim((string) $grade['admin_comments']) : '';
+
+                $response->fill([
+                    'score' => QuizScoring::normalizeWrittenScore((float) $grade['score']),
+                    'admin_comments' => $comment !== '' ? $comment : null,
+                    'grading_status' => 'graded',
+                    'graded_by' => $grader->id,
+                    'graded_at' => now(),
+                ])->save();
+            }
+
+            $result = $this->recalculate($attempt, $quiz);
+            $this->release($attempt, $grader);
+            $this->deliberation->invalidate($quiz);
+
+            return $result;
+        });
+
+        $this->notifyAfterGrading($quiz, $attempt, $result, $pendingBefore);
+
+        return $result;
+    }
+
+    // ------------------------------------------------------------------
+    // File de correction (réservation des copies)
+    // ------------------------------------------------------------------
+
+    private function copiesQuery(Quiz $quiz)
+    {
+        return QuizAttempt::where('quiz_id', $quiz->id)
+            ->where('status', 'completed')
+            ->whereHas('result')
+            ->whereHas('responses');
+    }
+
+    /**
+     * Réserve la prochaine copie à corriger (ou une copie précise pour la réviser).
+     * La réservation est atomique : deux correcteurs ne reçoivent jamais la même copie.
+     *
+     * @param list<int> $excludeIds copies à ignorer (ex. copies "passées" par le correcteur)
+     */
+    public function claim(Quiz $quiz, User $user, ?int $attemptId = null, array $excludeIds = []): ?QuizAttempt
+    {
+        $query = $this->copiesQuery($quiz);
+
+        if ($attemptId) {
+            $query->whereKey($attemptId);
+        } else {
+            $query->whereHas('result', fn ($q) => $q->where('grading_status', QuizResult::STATUS_PENDING))
+                ->when($excludeIds, fn ($q) => $q->whereNotIn('id', $excludeIds))
+                ->orderByRaw('CASE WHEN grading_claimed_by = ? THEN 0 ELSE 1 END', [$user->id])
+                ->orderBy('completed_at')
+                ->orderBy('id');
+        }
+
+        foreach ($query->limit(15)->pluck('id') as $id) {
+            // La condition WHERE rend la réservation atomique : si un autre correcteur détient une
+            // réservation encore valide, cette requête ne modifie rien.
+            QuizAttempt::whereKey($id)
+                ->where(function ($q) use ($user) {
+                    $q->whereNull('grading_claimed_by')
+                        ->orWhere('grading_claimed_by', $user->id)
+                        ->orWhere('grading_claimed_at', '<', now()->subMinutes(QuizAttempt::CLAIM_TTL_MINUTES));
+                })
+                ->update([
+                    'grading_claimed_by' => $user->id,
+                    'grading_claimed_at' => now(),
+                ]);
+
+            // On relit le propriétaire plutôt que de compter les lignes modifiées : MySQL renvoie
+            // 0 quand on reprend sa propre copie dans la même seconde (aucune valeur ne change).
+            $attempt = QuizAttempt::with('user:id,name,email')->find($id);
+            if ($attempt && (int) $attempt->grading_claimed_by === (int) $user->id) {
+                return $attempt;
+            }
+        }
+
+        return null;
+    }
+
+    public function release(QuizAttempt $attempt, User $user): void
+    {
+        QuizAttempt::whereKey($attempt->id)
+            ->where('grading_claimed_by', $user->id)
+            ->update(['grading_claimed_by' => null, 'grading_claimed_at' => null]);
+    }
+
+    /** Vérifie que la copie est bien réservée par ce correcteur (et que la réservation est valide). */
+    public function holdsClaim(QuizAttempt $attempt, User $user): bool
+    {
+        $fresh = QuizAttempt::find($attempt->id);
+
+        return $fresh
+            && (int) $fresh->grading_claimed_by === (int) $user->id
+            && $fresh->grading_claimed_at
+            && $fresh->grading_claimed_at->gt(now()->subMinutes(QuizAttempt::CLAIM_TTL_MINUTES));
+    }
+
+    /** @return array<string, int> */
+    public function stats(Quiz $quiz, User $user): array
+    {
+        $ttl = now()->subMinutes(QuizAttempt::CLAIM_TTL_MINUTES);
+
+        $copies = $this->copiesQuery($quiz)->with('result:id,attempt_id,grading_status')->get(['id', 'grading_claimed_by', 'grading_claimed_at']);
+
+        $pending = $copies->filter(fn ($a) => $a->result?->grading_status === QuizResult::STATUS_PENDING);
+        $activeClaim = fn ($a) => $a->grading_claimed_by && $a->grading_claimed_at && $a->grading_claimed_at->gt($ttl);
+
+        return [
+            'total' => $copies->count(),
+            'pending' => $pending->count(),
+            'graded' => $copies->count() - $pending->count(),
+            'mine' => $pending->filter(fn ($a) => $activeClaim($a) && (int) $a->grading_claimed_by === (int) $user->id)->count(),
+            'in_progress_elsewhere' => $pending->filter(fn ($a) => $activeClaim($a) && (int) $a->grading_claimed_by !== (int) $user->id)->count(),
+        ];
+    }
+
+    /**
+     * Liste des copies pour le panneau latéral de l'espace de correction.
+     *
+     * @return list<array<string, mixed>>
+     */
+    public function queue(Quiz $quiz, User $user): array
+    {
+        $ttl = now()->subMinutes(QuizAttempt::CLAIM_TTL_MINUTES);
+
+        return $this->copiesQuery($quiz)
+            ->with(['result:id,attempt_id,grading_status,score', 'claimedBy:id,name'])
+            ->orderBy('completed_at')
+            ->orderBy('id')
+            ->get()
+            ->map(function (QuizAttempt $a) use ($ttl, $user) {
+                $claimActive = $a->grading_claimed_by && $a->grading_claimed_at && $a->grading_claimed_at->gt($ttl);
+
+                return [
+                    'attempt_id' => $a->id,
+                    'label' => $this->copyLabel($a),
+                    'status' => $a->result?->grading_status,
+                    'claimed_by' => $claimActive ? $a->claimedBy?->name : null,
+                    'claimed_by_me' => $claimActive && (int) $a->grading_claimed_by === (int) $user->id,
+                ];
+            })
+            ->all();
+    }
+
+    public function copyLabel(QuizAttempt $attempt): string
+    {
+        return 'Copie n° ' . str_pad((string) $attempt->id, 4, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Contenu d'une copie prêt à être affiché dans l'espace de correction.
+     *
+     * @return array<string, mixed>
+     */
+    public function copyPayload(Quiz $quiz, QuizAttempt $attempt): array
+    {
+        $written = $quiz->questions()->where('question_type', 'written')->get();
+        $responses = QuizResponse::where('attempt_id', $attempt->id)->get()->keyBy('question_id');
+        $answers = $attempt->answers ?? [];
+
+        return [
+            'attempt_id' => $attempt->id,
+            'label' => $this->copyLabel($attempt),
+            'candidate_name' => $attempt->user?->name ?? $attempt->guest_name ?? 'Candidat externe',
+            'submitted_at' => $attempt->completed_at?->toIso8601String(),
+            'incidents' => is_array($attempt->cheating_logs) ? count($attempt->cheating_logs) : 0,
+            'is_review' => $attempt->result?->grading_status === QuizResult::STATUS_GRADED,
+            'items' => $written->values()->map(function ($q, $i) use ($responses, $answers) {
+                $response = $responses->get($q->id);
+                $text = $response?->answer_text ?? (is_string($answers[$q->id] ?? null) ? $answers[$q->id] : '');
+
+                return [
+                    'question_id' => $q->id,
+                    'number' => $i + 1,
+                    'question_text' => $q->question_text,
+                    'answer_text' => $text,
+                    'is_blank' => trim((string) $text) === '',
+                    'score' => $response && $response->grading_status === 'graded' ? (float) $response->score : null,
+                    'admin_comments' => $response?->admin_comments,
+                ];
+            })->all(),
+        ];
+    }
+
+    // ------------------------------------------------------------------
+    // Notifications
+    // ------------------------------------------------------------------
+
+    private function notifyAfterGrading(Quiz $quiz, QuizAttempt $attempt, QuizResult $result, int $pendingBefore): void
+    {
+        try {
+            $url = route('projects.quizzes.results', [$quiz->project_id, $quiz->id]);
+
+            if ($attempt->user_id && $quiz->show_results && $result->grading_status === QuizResult::STATUS_GRADED) {
+                User::find($attempt->user_id)?->notify(new QuizNotification('quiz_graded', [
+                    'quiz_id' => $quiz->id,
+                    'project_id' => $quiz->project_id,
+                    'quiz_title' => $quiz->title,
+                    'score' => QuizScoring::format((float) $result->score),
+                    'url' => $url,
+                ]));
+            }
+
+            if ($pendingBefore > 0 && $this->deliberation->pendingCopies($quiz) === 0) {
+                $this->deliberation->deciders($quiz)->each(function (User $decider) use ($quiz) {
+                    $decider->notify(new QuizNotification('quiz_ready_for_deliberation', [
+                        'quiz_id' => $quiz->id,
+                        'project_id' => $quiz->project_id,
+                        'quiz_title' => $quiz->title,
+                        'url' => route('projects.quizzes.deliberation', [$quiz->project_id, $quiz->id]),
+                    ]));
+                });
+            }
+        } catch (\Throwable $e) {
+            // Une notification ne doit jamais faire échouer une correction.
+            Log::warning('Quiz notification failed: ' . $e->getMessage());
+        }
+    }
+}
