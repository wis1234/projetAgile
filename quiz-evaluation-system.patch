+// Utilitaires partagés par toutes les pages du module Quiz.
+
+/** 72.5 -> "72,5" ; 80 -> "80" ; 66.666 -> "66,67" (format français, sans zéros inutiles). */
+export function formatScore(value) {
+  if (value === null || value === undefined || Number.isNaN(Number(value))) return '—';
+  const n = Math.round(Number(value) * 100) / 100;
+  return n.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
+}
+
+export const PASS_MARK = 50;
+
+/** Couleurs selon le résultat : gris/ambre si la copie attend encore sa correction. */
+export function scoreTone(score, pending = false, passMark = PASS_MARK) {
+  if (pending) return 'amber';
+  return Number(score) >= passMark ? 'emerald' : 'red';
+}
+
+export const TONES = {
+  emerald: {
+    text: 'text-emerald-600 dark:text-emerald-400',
+    soft: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300',
+    pill: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
+    border: 'border-emerald-500',
+    bar: 'bg-emerald-500',
+  },
+  red: {
+    text: 'text-red-600 dark:text-red-400',
+    soft: 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300',
+    pill: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
+    border: 'border-red-500',
+    bar: 'bg-red-500',
+  },
+  amber: {
+    text: 'text-amber-600 dark:text-amber-400',
+    soft: 'bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300',
+    pill: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
+    border: 'border-amber-500',
+    bar: 'bg-amber-500',
+  },
+  blue: {
+    text: 'text-blue-600 dark:text-blue-400',
+    soft: 'bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300',
+    pill: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
+    border: 'border-blue-500',
+    bar: 'bg-blue-500',
+  },
+  purple: {
+    text: 'text-purple-600 dark:text-purple-400',
+    soft: 'bg-purple-50 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300',
+    pill: 'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300',
+    border: 'border-purple-500',
+    bar: 'bg-purple-500',
+  },
+  indigo: {
+    text: 'text-indigo-600 dark:text-indigo-400',
+    soft: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300',
