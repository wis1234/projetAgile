new file mode 100644
index 0000000..77686d5
--- /dev/null
+++ b/tests/Feature/Quiz/QuizTestCase.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace Tests\Feature\Quiz;
+
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizQuestion;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Foundation\Testing\TestCase as BaseTestCase;
+use Spatie\Permission\Models\Role;
+
+/**
+ * Base des tests du module Quiz. Les migrations du projet utilisent du SQL MySQL :
+ * lancer avec DB_CONNECTION=mysql (voir README des tests).
+ */
+abstract class QuizTestCase extends BaseTestCase
+{
+    use RefreshDatabase;
+
+    protected Project $project;
+    protected User $manager;
+    protected User $manager2;
+    protected User $member;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->withoutVite();
+        config(['inertia.testing.ensure_pages_exist' => false]);
+
+        foreach (['admin', 'manager', 'member'] as $role) {
+            Role::firstOrCreate(['name' => $role, 'guard_name' => 'web']);
+        }
+
+        $this->project = Project::factory()->create();
+        $this->manager = User::factory()->create(['name' => 'Alice Manager']);
+        $this->manager2 = User::factory()->create(['name' => 'Bob Manager']);
+        $this->member = User::factory()->create(['name' => 'Chloé Membre']);
+
+        $this->project->users()->attach($this->manager->id, ['role' => 'manager']);
+        $this->project->users()->attach($this->manager2->id, ['role' => 'manager']);
+        $this->project->users()->attach($this->member->id, ['role' => 'member']);
+    }
+
+    /** Requête « Inertia » : on lit directement les props JSON, sans passer par Vite. */
+    protected function inertia(User $user, string $url)
+    {
+        return $this->actingAs($user)->getJson($url, ['X-Inertia' => 'true']);
+    }
+
+    protected function makeQuiz(array $questions, array $attrs = []): Quiz
+    {
+        $quiz = Quiz::create(array_merge([
+            'project_id' => $this->project->id,
+            'created_by' => $this->manager->id,
+            'title' => 'Évaluation test',
+            'quiz_type' => Quiz::deriveType(collect($questions)->pluck('type')),
+            'duration_minutes' => 30,
+            'max_attempts' => 2,
+        ], $attrs));
+
+        foreach ($questions as $i => $q) {
+            QuizQuestion::create([
+                'quiz_id' => $quiz->id,
+                'question_text' => $q['text'] ?? "Question {$i}",
+                'question_type' => $q['type'],
+                'option_a' => $q['type'] === 'qcm' ? 'A' : null,
+                'option_b' => $q['type'] === 'qcm' ? 'B' : null,
+                'correct_answer' => $q['type'] === 'qcm' ? ($q['correct'] ?? 0) : null,
+                'order' => $i + 1,
+            ]);
+        }
+
+        return $quiz->refresh();
+    }
+
+    protected function quizUrl(Quiz $quiz, string $suffix = ''): string
+    {
+        return "/projects/{$this->project->id}/quizzes/{$quiz->id}" . $suffix;
+    }
+}
