+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import axios from 'axios';
+import { Link, router } from '@inertiajs/react';
+import AdminLayout from '@/Layouts/AdminLayout';
+import {
+  FaCheckCircle,
+  FaClock,
+  FaExclamationTriangle,
+  FaEye,
+  FaEyeSlash,
+  FaForward,
+  FaGavel,
+  FaHourglassHalf,
+  FaLock,
+  FaPen,
+  FaSpinner,
+  FaUserSecret,
+  FaUsers,
+} from 'react-icons/fa';
+import { BackLink, Button, Card, Dialog, PageShell, Pill, ProgressBar, StatCard } from '@/Components/Quiz/ui';
+import { apiError, formatDate, formatScore } from '@/lib/quiz';
+
+const QUICK_SCORES = [0, 2, 4, 5, 6, 8, 10];
+const QUICK_COMMENTS = ['Excellent', 'Bonne réponse', 'Incomplet', 'Hors sujet', 'À développer'];
+const ANON_KEY = 'proja.correction.anonymous';
+
+const emptyGrades = (copy) =>
+  Object.fromEntries(
+    (copy?.items || []).map((it) => [
+      it.question_id,
+      { score: it.score ?? (it.is_blank ? 0 : null), admin_comments: it.admin_comments || '' },
+    ])
+  );
+
+function Correction({ project, quiz, hasWritten, isValidated, writtenMax = 10, claimMinutes = 15, initialCopy, stats: initialStats, queue: initialQueue }) {
+  const [copy, setCopy] = useState(initialCopy);
+  const [grades, setGrades] = useState(() => emptyGrades(initialCopy));
+  const [stats, setStats] = useState(initialStats);
+  const [queue, setQueue] = useState(initialQueue || []);
+  const [saving, setSaving] = useState(false);
+  const [loadingNext, setLoadingNext] = useState(false);
+  const [error, setError] = useState(null);
+  const [allDone, setAllDone] = useState(false);
+  const [skipped, setSkipped] = useState([]);
+  const [anonymous, setAnonymous] = useState(() => {
+    try {
+      return localStorage.getItem(ANON_KEY) !== '0';
+    } catch {
+      return true;
+    }
+  });
+
+  const copyRef = useRef(copy);
+  copyRef.current = copy;
+  const topRef = useRef(null);
+
+  const showRoute = route('projects.quizzes.show', [project.id, quiz.id]);
+  const url = (suffix) => route(`projects.quizzes.correction${suffix}`, [project.id, quiz.id]);
+  const attemptUrl = (name, id) => route(`projects.quizzes.correction.${name}`, [project.id, quiz.id, id]);
+
+  const toggleAnonymous = () => {
+    setAnonymous((v) => {
+      try {
+        localStorage.setItem(ANON_KEY, v ? '0' : '1');
+      } catch {
+        /* ignore */
+      }
+      return !v;
+    });
+  };
+
+  const applyResponse = useCallback((data) => {
+    if (data.stats) setStats(data.stats);
+    if (data.queue) setQueue(data.queue);
+  }, []);
+
+  const showCopy = useCallback((next) => {
+    setCopy(next);
+    setGrades(emptyGrades(next));
+    setError(null);
+    topRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' });
+  }, []);
+
+  // ------------------------------------------------------------------
+  // Réservation / libération des copies
+  // ------------------------------------------------------------------
+
+  const fetchNext = useCallback(
+    async (payload = {}) => {
+      setLoadingNext(true);
+      try {
+        const { data } = await axios.post(url('.next'), payload);
+        applyResponse(data);
+        return data.copy;
+      } catch (e) {
+        setError(apiError(e, 'Impossible de charger la copie suivante.'));
+        return null;
+      } finally {
+        setLoadingNext(false);
+      }
+    },
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [applyResponse]
+  );
+
+  // Libère la copie si le correcteur quitte la page (fermeture d'onglet ou navigation).
+  useEffect(() => {
+    const release = () => {
+      const current = copyRef.current;
+      if (!current) return;
+      const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
+      const body = new FormData();
+      if (token) body.append('_token', token);
+      navigator.sendBeacon?.(attemptUrl('release', current.attempt_id), body);
+    };
+    window.addEventListener('pagehide', release);
+    return () => {
+      window.removeEventListener('pagehide', release);
+      release();
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Garde la réservation active tant que la copie est ouverte.
+  useEffect(() => {
+    if (!copy) return undefined;
+    const every = Math.max(60, (claimMinutes - 5) * 60) * 1000;
+    const id = setInterval(() => {
+      axios.post(url('.next'), { attempt_id: copyRef.current?.attempt_id }).catch(() => {});
+    }, every);
+    return () => clearInterval(id);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [copy?.attempt_id]);
+
+  // Aucune copie libre mais d'autres correcteurs travaillent : on réessaie régulièrement.
+  const waiting = !copy && stats.pending > 0 && hasWritten && !isValidated;
+  useEffect(() => {
+    if (!waiting) return undefined;
+    const id = setInterval(async () => {
+      const next = await fetchNext({ exclude: skipped });
+      if (next) showCopy(next);
+    }, 10000);
+    return () => clearInterval(id);
+  }, [waiting, skipped, fetchNext, showCopy]);
+
+  // ------------------------------------------------------------------
+  // Notation
+  // ------------------------------------------------------------------
+
+  const setGrade = (questionId, patch) => setGrades((g) => ({ ...g, [questionId]: { ...g[questionId], ...patch } }));
+
+  const totals = useMemo(() => {
+    const items = copy?.items || [];
+    const scored = items.filter((it) => grades[it.question_id]?.score !== null && grades[it.question_id]?.score !== undefined && grades[it.question_id]?.score !== '');
+    const sum = scored.reduce((acc, it) => acc + Number(grades[it.question_id].score), 0);
+    const max = items.length * writtenMax;
+    return {
+      sum,
+      max,
+      percent: max ? (sum / max) * 100 : 0,
+      remaining: items.length - scored.length,
+      complete: items.length > 0 && scored.length === items.length,
+    };
+  }, [copy, grades, writtenMax]);
+
+  const save = useCallback(async () => {
+    if (!copy || !totals.complete || saving) return;
+    setSaving(true);
+    setError(null);
+    try {
+      const { data } = await axios.post(attemptUrl('save', copy.attempt_id), {
+        grades: copy.items.map((it) => ({
+          question_id: it.question_id,
+          score: Number(grades[it.question_id].score),
+          admin_comments: grades[it.question_id].admin_comments || null,
+        })),
+      });
+      applyResponse(data);
+      setSkipped([]);
+      if (data.all_done) {
+        setCopy(null);
+        setAllDone(true);
+      } else {
+        showCopy(data.copy);
+      }
+    } catch (e) {
+      setError(apiError(e, "La note n'a pas pu être enregistrée."));
+      if (e?.response?.status === 409) {
+        // Un autre correcteur a pris cette copie : on passe à la suivante.
+        const next = await fetchNext({ exclude: [...skipped, copy.attempt_id] });
+        showCopy(next);
+      }
+    } finally {
+      setSaving(false);
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [copy, grades, totals.complete, saving, skipped]);
+
+  const skip = async () => {
+    if (!copy) return;
+    const current = copy.attempt_id;
+    const exclude = [...skipped, current];
+    setSkipped(exclude);
+    await axios.post(attemptUrl('release', current)).catch(() => {});
+    const next = await fetchNext({ exclude });
+    if (next) {
+      showCopy(next);
+    } else {
+      // Plus rien d'autre : on reprend la copie passée.
+      const again = await fetchNext({ attempt_id: current });
+      setSkipped([]);
+      showCopy(again);
+    }
+  };
+
+  const openCopy = async (attemptId) => {
+    if (copy?.attempt_id === attemptId) return;
+    if (copy) await axios.post(attemptUrl('release', copy.attempt_id)).catch(() => {});
+    const next = await fetchNext({ attempt_id: attemptId });
+    if (next) showCopy(next);
+    else setError('Cette copie est en cours de correction par un autre correcteur.');
+  };
+
+  // Ctrl / Cmd + Entrée pour enregistrer.
+  useEffect(() => {
+    const onKey = (e) => {
+      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
+        e.preventDefault();
+        save();
+      }
+    };
+    document.addEventListener('keydown', onKey);
+    return () => document.removeEventListener('keydown', onKey);
+  }, [save]);
+
+  // ------------------------------------------------------------------
+  // États sans copie
+  // ------------------------------------------------------------------
+
+  const progress = stats.total > 0 ? (stats.graded / stats.total) * 100 : 0;
+
+  const header = (
+    <Card>
+      <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
+        <div className="min-w-0">
+          <BackLink href={route('projects.quizzes.ranking', [project.id, quiz.id])}>Retour au classement</BackLink>
+          <h1 className="text-2xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2.5 mt-2">
+            <FaPen className="text-purple-600 flex-shrink-0" />
+            <span className="truncate">Espace de correction</span>
+          </h1>
+          <p className="text-sm text-gray-500 dark:text-gray-400 truncate">{quiz.title}</p>
+        </div>
+
+        <div className="w-full lg:w-80">
+          <div className="flex items-center justify-between text-xs font-semibold text-gray-600 dark:text-gray-300 mb-1.5">
+            <span>Progression de la correction</span>
+            <span>
+              {stats.graded} / {stats.total}
+            </span>
+          </div>
+          <ProgressBar value={stats.graded} max={Math.max(stats.total, 1)} tone={stats.pending === 0 && stats.total > 0 ? 'emerald' : 'purple'} />
+          <p className="text-[11px] text-gray-400 mt-1.5">{Math.round(progress)} % des copies corrigées</p>
+        </div>
+      </div>
+    </Card>
+  );
+
+  if (!hasWritten || isValidated) {
+    return (
+      <PageShell max="max-w-4xl">
+        {header}
+        <Card className="text-center py-10">
+          <div className="w-16 h-16 mx-auto rounded-2xl bg-gray-100 dark:bg-gray-700 text-gray-500 flex items-center justify-center text-2xl mb-4">
+            <FaLock />
+          </div>
+          <h2 className="text-lg font-bold text-gray-900 dark:text-white mb-1">
+            {isValidated ? 'Résultats validés : correction verrouillée' : 'Aucune question écrite à corriger'}
+          </h2>
+          <p className="text-sm text-gray-500 dark:text-gray-400 max-w-md mx-auto mb-5">
+            {isValidated
+              ? 'Tous les responsables ont donné leur aval. Pour modifier une note, rouvrez d\'abord la délibération.'
+              : 'Ce quiz ne contient que des QCM, corrigés automatiquement.'}
+          </p>
+          <Link
+            href={isValidated ? route('projects.quizzes.deliberation', [project.id, quiz.id]) : showRoute}
+            className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold"
+          >
+            {isValidated ? (
+              <>
+                <FaGavel /> Aller à la délibération
+              </>
+            ) : (
+              'Retour aux détails du quiz'
+            )}
+          </Link>
+        </Card>
+      </PageShell>
+    );
+  }
+
+  return (
+    <PageShell>
+      <div ref={topRef} />
+      {header}
+
+      <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
+        <StatCard icon={<FaHourglassHalf />} tone="amber" label="Copies à corriger" value={stats.pending} />
+        <StatCard icon={<FaCheckCircle />} tone="emerald" label="Copies corrigées" value={stats.graded} />
+        <StatCard icon={<FaUsers />} tone="blue" label="En cours chez d'autres" value={stats.in_progress_elsewhere} />
+        <StatCard icon={<FaClock />} tone="purple" label="Vos copies réservées" value={stats.mine} />
+      </div>
+
+      {error && (
+        <div className="px-4 py-3 rounded-2xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 text-sm flex items-start gap-2">
+          <FaExclamationTriangle className="mt-0.5 flex-shrink-0" /> <span>{error}</span>
+        </div>
+      )}
+
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">
+        {/* Copie en cours */}
+        <div className="lg:col-span-2 space-y-4">
+          {copy ? (
