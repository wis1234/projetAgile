+            <table className="w-full text-sm">
+              <thead>
+                <tr className="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800/60">
+                  <th className="px-4 sm:px-6 py-3 w-14">Rang</th>
+                  <th className="px-2 py-3">Candidat</th>
+                  {columns.map((c) => (
