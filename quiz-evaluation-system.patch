+    public function test_full_correction_deliberation_and_export_flow(): void
+    {
+        $quiz = $this->mixedQuiz();
+        [$qcm, $w1, $w2] = $quiz->questions->all();
+
+        $attemptA = $this->take($this->member, $quiz, [$qcm->id => 0, $w1->id => 'réponse 1', $w2->id => 'réponse 2']);
+
+        // --- Correction ---------------------------------------------------
+        $page = $this->inertia($this->manager, $this->quizUrl($quiz, '/correction'))->json('props');
+        $this->assertSame($attemptA->id, $page['initialCopy']['attempt_id']);
+        $this->assertSame(1, $page['stats']['pending']);
+
+        $save = $this->actingAs($this->manager)->postJson($this->quizUrl($quiz, "/correction/{$attemptA->id}/save"), [
+            'grades' => [
+                ['question_id' => $w1->id, 'score' => 8, 'admin_comments' => 'Bien'],
+                ['question_id' => $w2->id, 'score' => 6.4],
+            ],
+        ])->assertOk();
+
+        // QCM 100 % ; écrit (8 + 6,5) / 20 = 72,5 % ; moyenne = 86,25
+        $save->assertJsonPath('result.grading_status', 'graded');
+        $this->assertEquals(86.25, $save->json('result.score'));
+        $save->assertJsonPath('all_done', true);
+        $this->assertNull($save->json('copy'));
+
+        // --- Délibération -------------------------------------------------
+        $url = $this->quizUrl($quiz, '/deliberation/approve');
+
+        $this->actingAs($this->manager)->post($url, ['password' => 'mauvais'])->assertSessionHasErrors('password');
+        $this->assertSame(0, $quiz->approvals()->count());
+
+        $this->actingAs($this->manager)->post($url, ['password' => 'password'])->assertSessionHas('success');
+        $this->assertFalse($quiz->refresh()->isValidated(), 'un seul aval ne suffit pas');
+
+        $this->actingAs($this->manager2)->post($url, ['password' => 'password']);
+        $this->assertTrue($quiz->refresh()->isValidated());
+
+        // Quiz clôturé : plus de nouvelle tentative ni de re-correction
+        $this->actingAs($this->manager)->post($this->quizUrl($quiz, '/launch'))->assertForbidden();
+        $this->actingAs($this->manager)->postJson($this->quizUrl($quiz, "/correction/{$attemptA->id}/save"), [
+            'grades' => [['question_id' => $w1->id, 'score' => 1], ['question_id' => $w2->id, 'score' => 1]],
+        ])->assertStatus(423);
+
+        // --- Exports ------------------------------------------------------
+        $xlsx = $this->actingAs($this->manager)->get($this->quizUrl($quiz, '/export/xlsx'))->assertOk();
+        $this->assertStringContainsString('spreadsheetml', $xlsx->headers->get('content-type'));
+
+        $pdf = $this->actingAs($this->manager)->get($this->quizUrl($quiz, '/export/pdf'))->assertOk();
+        $this->assertStringStartsWith('%PDF', $pdf->getContent());
+
+        // Un membre ne peut pas exporter
+        $this->actingAs($this->member)->get($this->quizUrl($quiz, '/export/pdf'))->assertForbidden();
+
+        // --- Réouverture : les avals sont annulés -------------------------
+        $this->actingAs($this->manager)->post($this->quizUrl($quiz, '/deliberation/reopen'), ['password' => 'password']);
+        $quiz->refresh();
+        $this->assertFalse($quiz->isValidated());
+        $this->assertSame(0, $quiz->approvals()->count());
+    }
