+                            {r.is_guest && <p className="text-[11px] text-gray-400 truncate">{r.email}</p>}
+                          </div>
+                        </div>
+                      </td>
+                      <td className="px-2 py-3 text-right text-gray-600 dark:text-gray-300">
+                        <ScoreDisplay score={r.quiz_score} pending={r.pending} />
+                      </td>
+                      {weight > 0 && (
+                        <td className="px-2 py-3 text-right text-gray-600 dark:text-gray-300 hidden sm:table-cell">
+                          {formatScore(r.participation_points)} pts
+                        </td>
+                      )}
+                      <td className={`px-2 py-3 text-right font-extrabold ${TONES[tone].text}`}>
+                        <ScoreDisplay score={r.final_score} pending={r.pending} />
+                      </td>
+                      <td className="px-4 sm:px-6 py-3 text-right">
+                        {r.pending ? (
+                          <Pill tone="amber">En attente</Pill>
+                        ) : r.final_score >= PASS_MARK ? (
+                          <Pill tone="emerald">Admis</Pill>
+                        ) : (
+                          <Pill tone="red">Ajourné</Pill>
+                        )}
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </Card>
+
+      <PasswordConfirmModal
+        open={modal === 'approve'}
+        onClose={closeModal}
+        onConfirm={submitPassword}
+        processing={processing}
+        error={passwordError}
+        title="Donner mon aval"
+        description="En confirmant, vous attestez que les résultats de ce quiz sont corrects. Saisissez votre mot de passe ProJA pour valider."
+        confirmLabel="Donner mon aval"
+      />
+      <PasswordConfirmModal
+        open={modal === 'reopen'}
+        onClose={closeModal}
+        onConfirm={submitPassword}
+        processing={processing}
+        error={passwordError}
+        variant="danger"
+        title="Rouvrir la délibération"
+        description="Tous les avals déjà donnés seront annulés et les notes redeviendront modifiables. Confirmez avec votre mot de passe."
+        confirmLabel="Rouvrir"
+      />
+    </PageShell>
+  );
+}
+
+Deliberation.layout = (page) => <AdminLayout>{page}</AdminLayout>;
+export default Deliberation;
