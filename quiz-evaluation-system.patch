new file mode 100644
index 0000000..d2e9ab3
--- /dev/null
+++ b/app/Http/Controllers/QuizCumulController.php
@@ -0,0 +1,191 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Exports\QuizSheetExport;
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\QuizCumul;
+use App\Models\QuizResult;
+use App\Services\Quiz\CumulService;
+use App\Services\Quiz\ExportBuilder;
+use Barryvdh\DomPDF\Facade\Pdf;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Inertia\Inertia;
+use Maatwebsite\Excel\Facades\Excel;
+
+/**
+ * Cumul de plusieurs quiz : moyenne de chaque candidat sur les quiz sélectionnés.
+ */
+class QuizCumulController extends Controller
+{
+    public function __construct(
+        private CumulService $cumuls,
+        private ExportBuilder $exports,
+    ) {
+    }
+
+    public function create(Project $project)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $quizzes = Quiz::forProject($project->id)->published()->withCount('questions')->orderByDesc('created_at')->get();
+        $ids = $quizzes->pluck('id');
+
+        $results = QuizResult::whereIn('quiz_id', $ids)->selectRaw('quiz_id, COUNT(*) as c')->groupBy('quiz_id')->pluck('c', 'quiz_id');
+        $pending = $this->cumuls->pendingCounts($ids);
+
+        return Inertia::render('Quizzes/CumulCreate', [
+            'project' => ['id' => $project->id, 'name' => $project->name],
+            'quizzes' => $quizzes->map(fn (Quiz $q) => [
+                'id' => $q->id,
+                'title' => $q->title,
+                'quiz_type' => $q->quiz_type,
+                'questions_count' => $q->questions_count,
+                'results_count' => $results->get($q->id, 0),
+                'pending_copies' => $pending[$q->id] ?? 0,
+                'validated' => $q->isValidated(),
+                'created_at' => $q->created_at,
+            ])->values(),
+        ]);
+    }
+
+    /** Aperçu du calcul avant validation. */
+    public function preview(Request $request, Project $project): JsonResponse
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        [$coefficients, $data] = $this->validateSelection($request, $project);
+
+        return response()->json($this->cumuls->compute($coefficients, $data['missing_policy'], $data['pass_mark']));
+    }
+
+    public function store(Request $request, Project $project)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $request->validate([
+            'title' => ['required', 'string', 'max:255'],
+            'description' => ['nullable', 'string', 'max:2000'],
+        ]);
+
+        [$coefficients, $data] = $this->validateSelection($request, $project);
+
+        $cumul = DB::transaction(function () use ($request, $project, $coefficients, $data) {
+            $cumul = QuizCumul::create([
+                'project_id' => $project->id,
+                'created_by' => Auth::id(),
+                'title' => $request->input('title'),
+                'description' => $request->input('description'),
+                'missing_policy' => $data['missing_policy'],
+                'pass_mark' => $data['pass_mark'],
+            ]);
+
+            $position = 0;
+            foreach ($coefficients as $quizId => $coefficient) {
+                $cumul->items()->create([
+                    'quiz_id' => $quizId,
+                    'coefficient' => $coefficient,
+                    'position' => $position++,
+                ]);
+            }
+
+            return $cumul;
+        });
+
+        if (function_exists('activity_log')) {
+            activity_log('create', "Cumul '{$cumul->title}' créé (" . count($coefficients) . ' quiz)', $project);
+        }
+
+        return redirect()->route('projects.quizzes.index', $project->id)
+            ->with('success', 'Cumul créé avec succès !');
+    }
+
+    public function show(Project $project, QuizCumul $cumul)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $computed = $this->compute($cumul);
+
+        return Inertia::render('Quizzes/CumulShow', [
+            'project' => ['id' => $project->id, 'name' => $project->name],
+            'cumul' => $cumul->only(['id', 'title', 'description', 'missing_policy', 'pass_mark', 'created_at']),
+            'computed' => $computed,
+        ]);
+    }
+
+    public function destroy(Project $project, QuizCumul $cumul)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $title = $cumul->title;
+        $cumul->delete();
+
+        return redirect()->route('projects.quizzes.index', $project->id)
+            ->with('success', "Cumul « {$title} » supprimé.");
+    }
+
+    public function export(Project $project, QuizCumul $cumul, string $format)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+        abort_unless(in_array($format, ['xlsx', 'pdf'], true), 404);
+
+        $data = $this->exports->cumulData($project, $cumul, $this->compute($cumul));
+        $name = 'cumul-' . Str::slug($cumul->title);
+
+        if ($format === 'pdf') {
+            return Pdf::loadView('exports.quiz.cumul-pdf', ['d' => $data])
+                ->setPaper('a4', 'landscape')
+                ->download($name . '.pdf');
+        }
+
+        [$rows, $headerRows, $titleRows] = $this->exports->cumulSheet($data);
+
+        return Excel::download(new QuizSheetExport($rows, $cumul->title, $headerRows, $titleRows), $name . '.xlsx');
+    }
+
+    private function compute(QuizCumul $cumul): array
+    {
+        $coefficients = $cumul->items()->get()->mapWithKeys(fn ($i) => [$i->quiz_id => (float) $i->coefficient])->all();
+
+        return $this->cumuls->compute($coefficients, $cumul->missing_policy, $cumul->pass_mark);
+    }
+
+    /**
+     * Valide la sélection : au moins 2 quiz du projet, tous entièrement corrigés.
+     *
+     * @return array{0: array<int, float>, 1: array<string, mixed>}
+     */
+    private function validateSelection(Request $request, Project $project): array
+    {
+        $data = $request->validate([
+            'quiz_ids' => ['required', 'array', 'min:2', 'max:30'],
+            'quiz_ids.*' => ['integer', 'distinct', Rule::exists('quizzes', 'id')->where('project_id', $project->id)->where('is_draft', false)],
+            'coefficients' => ['nullable', 'array'],
+            'coefficients.*' => ['numeric', 'min:0.01', 'max:99'],
+            'missing_policy' => ['required', Rule::in([QuizCumul::MISSING_ZERO, QuizCumul::MISSING_IGNORE])],
+            'pass_mark' => ['required', 'integer', 'min:0', 'max:100'],
+        ]);
+
+        $pending = $this->cumuls->pendingCounts(collect($data['quiz_ids']));
+        if ($pending) {
+            $titles = Quiz::whereIn('id', array_keys($pending))->pluck('title')->implode(', ');
+            throw ValidationException::withMessages([
+                'quiz_ids' => "Des copies restent à corriger dans : {$titles}. Terminez la correction avant de cumuler.",
+            ]);
+        }
+
+        $coefficients = [];
+        foreach ($data['quiz_ids'] as $id) {
+            $coefficients[(int) $id] = (float) ($data['coefficients'][$id] ?? 1);
+        }
+
+        return [$coefficients, $data];
+    }
+}
