+                            )}
+                          </td>
+                        </tr>
+                      )}
+                    </React.Fragment>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+        )}
+      </Card>
+    </PageShell>
+  );
+}
+
+CumulShow.layout = (page) => <AdminLayout>{page}</AdminLayout>;
+export default CumulShow;
