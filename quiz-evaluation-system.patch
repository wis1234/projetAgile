+            </p>
+            <Button variant="primary" onClick={submit} disabled={submitting || ids.length < 2 || invalidCoefficient}>
+              {submitting ? <FaSpinner className="animate-spin" /> : <FaSave />} Valider et créer le cumul
+            </Button>
+          </div>
+        </div>
+      </div>
+    </PageShell>
+  );
+}
+
+function Mini({ label, value }) {
+  return (
+    <div className="py-3">
+      <div className="text-lg font-extrabold text-gray-900 dark:text-white">{value}</div>
