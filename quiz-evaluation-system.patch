+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Quiz;
+use App\Models\QuizQuestion;
+
+/**
+ * Création et synchronisation des questions d'un quiz.
+ */
+class QuizBuilder
+{
+    /** @param array<string, mixed> $q */
+    public function normalize(array $q, int $order): array
+    {
+        $isQcm = ($q['question_type'] ?? 'qcm') === 'qcm';
+
+        return [
+            'question_text' => trim($q['question_text']),
+            'question_type' => $q['question_type'],
+            'option_a' => $isQcm ? ($q['option_a'] ?? null) : null,
+            'option_b' => $isQcm ? ($q['option_b'] ?? null) : null,
+            'option_c' => $isQcm ? (($q['option_c'] ?? '') !== '' ? $q['option_c'] : null) : null,
+            'option_d' => $isQcm ? (($q['option_d'] ?? '') !== '' ? $q['option_d'] : null) : null,
+            'correct_answer' => $isQcm && isset($q['correct_answer']) ? (int) $q['correct_answer'] : null,
+            'order' => $order,
+        ];
+    }
+
+    /**
+     * Synchronise les questions par identifiant : les questions existantes sont mises à jour
+     * (et non supprimées puis recréées, ce qui effacerait les réponses déjà enregistrées).
+     *
+     * @param array<int, array<string, mixed>> $questions dans l'ordre voulu
+     */
+    public function sync(Quiz $quiz, array $questions): void
+    {
+        $existing = $quiz->questions()->get()->keyBy('id');
+        $keep = [];
+
+        foreach (array_values($questions) as $index => $q) {
+            $data = $this->normalize($q, $index + 1);
+            $id = isset($q['id']) ? (int) $q['id'] : null;
+
+            if ($id && $existing->has($id)) {
+                $existing->get($id)->update($data);
+                $keep[] = $id;
+            } else {
+                $keep[] = QuizQuestion::create($data + ['quiz_id' => $quiz->id])->id;
+            }
+        }
+
+        $quiz->questions()->whereNotIn('id', $keep)->delete();
+        $this->refreshType($quiz);
+    }
+
+    public function refreshType(Quiz $quiz): void
+    {
+        $types = $quiz->questions()->pluck('question_type');
+
+        if ($types->isNotEmpty()) {
+            $quiz->update(['quiz_type' => Quiz::deriveType($types)]);
+        }
+    }
+}
diff --git a/app/Services/Quiz/QuizScoring.php b/app/Services/Quiz/QuizScoring.php
new file mode 100644
index 0000000..8d010ca
--- /dev/null
+++ b/app/Services/Quiz/QuizScoring.php
@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Services\Quiz;
+
+/**
+ * Règles de calcul des notes (fonctions pures, sans base de données).
+ *
+ * - QCM seul       : note = % de bonnes réponses.
+ * - Écrit seul     : note = total des points / (nb de questions × 10).
+ * - Mixte          : moyenne du % QCM et du % écrit (50 % / 50 %).
+ * - Participation  : pondération optionnelle (poids en %, 0 = désactivée).
+ */
+final class QuizScoring
+{
+    /** Barème d'une question écrite. */
+    public const WRITTEN_MAX = 10;
+
+    public const PASS_MARK = 50;
+
+    public static function percent(float $earned, float $max): float
+    {
+        if ($max <= 0) {
+            return 0.0;
+        }
+
+        return round(($earned / $max) * 100, 2);
+    }
+
+    /**
+     * @param float|null $qcmPercent     null = le quiz n'a pas de QCM
+     * @param float|null $writtenPercent null = le quiz n'a pas de question écrite
+     */
+    public static function combine(?float $qcmPercent, ?float $writtenPercent): float
+    {
+        if ($qcmPercent === null && $writtenPercent === null) {
+            return 0.0;
+        }
+
+        if ($qcmPercent === null) {
+            return round($writtenPercent, 2);
+        }
+
+        if ($writtenPercent === null) {
+            return round($qcmPercent, 2);
+        }
+
+        return round(($qcmPercent + $writtenPercent) / 2, 2);
+    }
+
+    /** Note (sur 10) arrondie au demi-point et bornée. */
+    public static function normalizeWrittenScore(float $score): float
+    {
+        $score = max(0, min(self::WRITTEN_MAX, $score));
+
+        return round($score * 2) / 2;
+    }
+
+    /** Points de participation cumulés, bornés entre 0 et le plafond du quiz. */
+    public static function participationPercent(float $points, float $max): float
+    {
+        if ($max <= 0) {
+            return 0.0;
+        }
+
+        return round(max(0, min($max, $points)) / $max * 100, 2);
+    }
+
+    /**
+     * Note finale = note du quiz × (1 - poids) + participation × poids.
+     */
+    public static function finalScore(float $quizScore, float $participationPercent, int $weight): float
+    {
+        $weight = max(0, min(100, $weight));
+
+        if ($weight === 0) {
+            return round($quizScore, 2);
+        }
+
+        return round(($quizScore * (100 - $weight) + $participationPercent * $weight) / 100, 2);
+    }
+
+    public static function isPassed(float $score, int $passMark = self::PASS_MARK): bool
+    {
+        return $score >= $passMark;
+    }
+
+    /** Format lisible (français) : 72,5 — sans zéros inutiles. */
+    public static function format(float $value): string
+    {
+        $formatted = number_format($value, 2, ',', '');
+
+        return rtrim(rtrim($formatted, '0'), ',');
+    }
+}
diff --git a/app/Services/Quiz/ResultsService.php b/app/Services/Quiz/ResultsService.php
new file mode 100644
index 0000000..548c2ad
--- /dev/null
+++ b/app/Services/Quiz/ResultsService.php
@@ -0,0 +1,139 @@
+<?php
+
+namespace App\Services\Quiz;
+
+use App\Models\Quiz;
+use App\Models\QuizParticipationPoint;
+use App\Models\QuizResult;
+use Illuminate\Support\Collection;
+
+/**
+ * Construit la vue "candidats" d'un quiz : meilleure tentative, points de participation,
+ * note finale et rang. C'est la source unique pour le classement, la délibération,
+ * les exports et les cumuls.
+ */
+class ResultsService
+{
+    /**
+     * @return Collection<int, array<string, mixed>> triée par rang
+     */
+    public function candidateRows(Quiz $quiz): Collection
+    {
+        $results = QuizResult::where('quiz_id', $quiz->id)
+            ->with('user:id,name,email,profile_photo_path')
+            ->get();
+
+        $participation = $this->participationTotals($quiz);
+        $max = (float) $quiz->participation_max;
+        $weight = (int) $quiz->participation_weight;
+
+        $rows = $results->groupBy(fn (QuizResult $r) => $r->candidateKey())
+            ->map(function (Collection $group, string $key) use ($participation, $max, $weight) {
+                /** @var QuizResult $best */
+                $best = $group->sort(function (QuizResult $a, QuizResult $b) {
+                    return [$b->score, $b->completed_at?->timestamp ?? 0]
+                        <=> [$a->score, $a->completed_at?->timestamp ?? 0];
+                })->first();
+
+                $points = (float) ($participation[$key]['points'] ?? 0);
+                $partPercent = QuizScoring::participationPercent($points, $max);
+
+                return [
+                    'key' => $key,
+                    'user_id' => $best->user_id,
+                    'name' => $best->user?->name ?? $best->guest_name ?? 'Candidat externe',
+                    'email' => $best->user?->email ?? $best->guest_email,
+                    'photo' => $best->user?->profile_photo_url,
+                    'is_guest' => $best->user_id === null,
+                    'attempts_count' => $group->count(),
+                    'result_id' => $best->id,
+                    'attempt_id' => $best->attempt_id,
+                    'quiz_score' => (float) $best->score,
+                    'pending' => $group->contains(fn (QuizResult $r) => $r->isPending()),
+                    'correct_answers' => $best->correct_answers,
+                    'total_questions' => $best->total_questions,
+                    'participation_points' => round(max(0, $points), 2),
+                    'participation_percent' => $partPercent,
+                    'final_score' => QuizScoring::finalScore((float) $best->score, $partPercent, $weight),
+                    'completed_at' => $best->completed_at?->toIso8601String(),
+                ];
+            })
+            ->values();
+
+        return $this->rank($rows);
+    }
+
+    /** Classement "compétition" : 1, 2, 2, 4… (ex æquo = même rang). */
+    public function rank(Collection $rows): Collection
+    {
+        $sorted = $rows->sort(function (array $a, array $b) {
+            return [$b['final_score'], $a['completed_at'] ?? ''] <=> [$a['final_score'], $b['completed_at'] ?? ''];
+        })->values();
+
+        $rank = 0;
+        $previous = null;
+
+        return $sorted->map(function (array $row, int $index) use (&$rank, &$previous) {
+            if ($previous === null || $row['final_score'] !== $previous) {
+                $rank = $index + 1;
+            }
+            $previous = $row['final_score'];
+            $row['rank'] = $rank;
+
+            return $row;
+        });
+    }
+
+    /**
+     * @return array<string, array{points: float, name: ?string, email: ?string, user_id: ?int}>
+     */
+    public function participationTotals(Quiz $quiz): array
+    {
+        $totals = [];
+
+        QuizParticipationPoint::where('quiz_id', $quiz->id)->get()
+            ->each(function (QuizParticipationPoint $p) use (&$totals) {
+                $key = $p->candidateKey();
+                $totals[$key] ??= [
+                    'points' => 0.0,
+                    'name' => $p->guest_name,
+                    'email' => $p->guest_email,
+                    'user_id' => $p->user_id,
+                ];
+                $totals[$key]['points'] += (float) $p->points;
+            });
+
+        return $totals;
+    }
+
+    /**
+     * @param Collection<int, array<string, mixed>> $rows
+     * @return array<string, mixed>
+     */
+    public function summary(Collection $rows, int $passMark = QuizScoring::PASS_MARK): array
+    {
+        $count = $rows->count();
+        $scores = $rows->pluck('final_score');
+
+        $distribution = array_fill(0, 10, 0);
+        foreach ($scores as $score) {
+            $bucket = (int) min(9, floor($score / 10));
+            $distribution[$bucket]++;
+        }
+
+        $passed = $rows->filter(fn ($r) => ! $r['pending'] && QuizScoring::isPassed($r['final_score'], $passMark))->count();
+        $graded = $rows->filter(fn ($r) => ! $r['pending']);
+
+        return [
+            'count' => $count,
+            'pending_count' => $rows->where('pending', true)->count(),
+            'average' => $graded->count() ? round($graded->avg('final_score'), 2) : null,
+            'highest' => $graded->count() ? $graded->max('final_score') : null,
+            'lowest' => $graded->count() ? $graded->min('final_score') : null,
+            'passed_count' => $passed,
+            'pass_rate' => $graded->count() ? round($passed / $graded->count() * 100, 1) : null,
+            'pass_mark' => $passMark,
+            'distribution' => $distribution,
+        ];
+    }
+}
