@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Project;
+use App\Models\Quiz;
+use App\Models\User;
+use App\Notifications\QuizNotification;
+use App\Services\Quiz\DeliberationService;
+use App\Services\Quiz\ResultsService;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Inertia\Inertia;
+
+/**
+ * Délibération : chaque responsable confirme les résultats avec son mot de passe ProJA.
+ */
+class QuizDeliberationController extends Controller
+{
+    public function __construct(
+        private DeliberationService $deliberation,
+        private ResultsService $results,
+    ) {
+    }
+
+    public function show(Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $rows = $this->results->candidateRows($quiz);
+
+        return Inertia::render('Quizzes/Deliberation', [
+            'project' => ['id' => $project->id, 'name' => $project->name],
+            'quiz' => $quiz->only(['id', 'title', 'deliberation_status', 'participation_weight', 'participation_max']),
+            'deliberation' => $this->deliberation->summary($quiz, Auth::user()),
+            'rows' => $rows->values(),
+            'summary' => $this->results->summary($rows),
+        ]);
+    }
+
+    public function approve(Request $request, Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $this->assertPassword($request);
+
+        try {
+            $validated = $this->deliberation->approve($quiz, Auth::user(), $request->ip());
+        } catch (\DomainException $e) {
+            return back()->with('error', $e->getMessage());
+        }
+
+        if (function_exists('activity_log')) {
+            activity_log('update', Auth::user()->name . " a donné son aval pour le quiz '{$quiz->title}'", $quiz);
+        }
+
+        if ($validated) {
+            $this->notifyValidated($quiz);
+
+            return back()->with('success', 'Tous les responsables ont donné leur aval : les résultats sont validés.');
+        }
+
+        return back()->with('success', 'Votre aval a été enregistré.');
+    }
+
+    public function reopen(Request $request, Project $project, Quiz $quiz)
+    {
+        $this->authorize('manage', [Quiz::class, $project]);
+
+        $this->assertPassword($request);
+
+        $this->deliberation->invalidate($quiz);
+
+        if (function_exists('activity_log')) {
+            activity_log('update', Auth::user()->name . " a rouvert la délibération du quiz '{$quiz->title}'", $quiz);
+        }
+
+        return back()->with('success', 'Délibération rouverte : tous les avals ont été annulés.');
+    }
+
+    private function assertPassword(Request $request): void
+    {
+        $request->validate(['password' => ['required', 'string']]);
+
+        if (! Hash::check($request->input('password'), Auth::user()->password)) {
+            throw ValidationException::withMessages(['password' => 'Mot de passe incorrect.']);
+        }
+    }
+
+    private function notifyValidated(Quiz $quiz): void
+    {
+        try {
+            $this->deliberation->deciders($quiz)->each(function (User $u) use ($quiz) {
+                $u->notify(new QuizNotification('quiz_validated', [
+                    'quiz_id' => $quiz->id,
+                    'project_id' => $quiz->project_id,
+                    'quiz_title' => $quiz->title,
+                    'url' => route('projects.quizzes.deliberation', [$quiz->project_id, $quiz->id]),
+                ]));
+            });
+        } catch (\Throwable $e) {
+            Log::warning('Quiz validation notification failed: ' . $e->getMessage());
+        }
+    }
+}
